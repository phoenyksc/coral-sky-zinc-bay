<section class="section">
  <div class="page-width">
    <p class="kicker">The vault</p>
    <h1 style="font-size:3rem;margin:.4rem 0 2rem">Collections</h1>
    <div class="collection-tiles">
      {% for collection in collections %}
        {% unless collection.handle == 'all' %}
          <a class="tile" href="{{ collection.url }}">
            {% if collection.featured_image %}
              {{ collection.featured_image | image_url: width: 900 | image_tag: alt: collection.title, loading: 'lazy' }}
            {% endif %}
            <span class="tile-veil"></span>
            <span>{{ collection.title }}</span>
          </a>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Collections", "settings": [] }
{% endschema %}
