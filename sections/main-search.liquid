{% paginate search.results by 48 %}
<section class="section">
  <div class="page-width">
    <h1 style="font-size:3rem">Search</h1>
    <form class="search-form" action="{{ routes.search_url }}" method="get">
      <input class="field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Brand, product, SKU…">
      <input type="hidden" name="type" value="product">
      <button class="btn" type="submit">Search</button>
    </form>
    {% if search.performed %}
      <p style="color:var(--muted);margin-bottom:1.5rem">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for “{{ search.terms }}”</p>
      <div class="product-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', product: item %}
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p style="color:var(--muted)">Try MAC, Double Wear, or Clinique.</p>
    {% endif %}
  </div>
</section>
{% endpaginate %}

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
