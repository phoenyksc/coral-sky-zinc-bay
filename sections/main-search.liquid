{% comment %}
  Search results. 2026-10-05 Dru: Load more OR Show all (same pattern as main-collection).
  Based on live 31-line main-search (paginate 48, render product-card).
  2026-10-12 parity A1+B3: filter bar (Price / Type / Brand via search.filters) + Sort, active chips, Clear all,
  in-range prices on cards when a price filter is set (snippets/search-facets, snippets/search-card).
{% endcomment %}
{%- assign sb_pmin = blank -%}{%- assign sb_pmax = blank -%}
{%- for f in search.filters -%}{%- if f.type == 'price_range' -%}{%- assign sb_pmin = f.min_value.value -%}{%- assign sb_pmax = f.max_value.value -%}{%- endif -%}{%- endfor -%}
{% paginate search.results by 48 %}
<style>
  #SearchSection-{{ section.id }} .sb-sfacets{margin:0 0 .75rem}
  #SearchSection-{{ section.id }} .sb-sf-bar{display:flex;flex-wrap:wrap;gap:.6rem;align-items:flex-end;justify-content:space-between;border-top:1px solid #e6e1d8;border-bottom:1px solid #e6e1d8;padding:.7rem 0}
  #SearchSection-{{ section.id }} .sb-sf-filters{display:flex;flex-wrap:wrap;gap:.6rem;align-items:flex-end}
  #SearchSection-{{ section.id }} .sb-sf-sel{display:flex;flex-direction:column;gap:.2rem;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  #SearchSection-{{ section.id }} .sb-sf-sel select{min-width:9.5rem;max-width:14rem;padding:.5rem 2rem .5rem .7rem;font-size:.9rem;text-transform:none;letter-spacing:0;font-weight:400;border-radius:999px}
  #SearchSection-{{ section.id }} [data-active] select,#SearchSection-{{ section.id }} details[data-active]>summary{border-color:#1a1a1a;box-shadow:inset 0 0 0 1px #1a1a1a}
  #SearchSection-{{ section.id }} .sb-sf-dd{position:relative}
  #SearchSection-{{ section.id }} .sb-sf-dd>summary{list-style:none;cursor:pointer;border:1px solid #cfc8bc;border-radius:999px;padding:.5rem 1.6rem .5rem .9rem;font-size:.9rem;background:#fff;position:relative}
  #SearchSection-{{ section.id }} .sb-sf-dd>summary::after{content:'▾';position:absolute;right:.7rem;top:.45rem;font-size:.8rem}
  #SearchSection-{{ section.id }} .sb-sf-dd>summary::-webkit-details-marker{display:none}
  #SearchSection-{{ section.id }} .sb-sf-panel{position:absolute;z-index:20;top:calc(100% + 6px);left:0;background:#fff;border:1px solid #e6e1d8;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.12);padding:.9rem;display:flex;flex-direction:column;gap:.7rem;width:17rem}
  #SearchSection-{{ section.id }} .sb-sf-price{display:flex;gap:.4rem;align-items:flex-end}
  #SearchSection-{{ section.id }} .sb-sf-price label{display:flex;flex-direction:column;font-size:.72rem;font-weight:700}
  #SearchSection-{{ section.id }} .sb-sf-price input{width:6.2rem}
  #SearchSection-{{ section.id }} .sb-sf-quick{display:flex;flex-wrap:wrap;gap:.35rem}
  #SearchSection-{{ section.id }} .sb-sf-quick a{font-size:.8rem;border:1px solid #cfc8bc;border-radius:999px;padding:.25rem .6rem;color:inherit;text-decoration:none}
  #SearchSection-{{ section.id }} .sb-chips{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.7rem}
  #SearchSection-{{ section.id }} .sb-chip{display:inline-flex;gap:.35rem;align-items:center;background:#1a1a1a;color:#fff;border-radius:999px;padding:.32rem .75rem;font-size:.82rem;text-decoration:none}
  #SearchSection-{{ section.id }} .sb-chip--clear{background:transparent;color:#1a1a1a;text-decoration:underline;padding-left:.3rem}
  #SearchSection-{{ section.id }} .visually-hidden{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  @media(max-width:749px){
    #SearchSection-{{ section.id }} .sb-sf-bar{display:grid;grid-template-columns:1fr 1fr;align-items:end}
    #SearchSection-{{ section.id }} .sb-sf-filters{display:contents}
    #SearchSection-{{ section.id }} .sb-sf-sel select{min-width:0;width:100%;max-width:none}
    #SearchSection-{{ section.id }} .sb-sf-dd>summary{width:100%}
    #SearchSection-{{ section.id }} .sb-sf-panel{width:min(17rem,90vw)}
  }
</style>
<section class="section" id="SearchSection-{{ section.id }}">
  <div class="page-width">
    <h1 style="font-size:3rem">Search</h1>
    <form class="search-form" action="{{ routes.search_url }}" method="get">
      <input class="field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Brand, product, SKU…">
      <input type="hidden" name="type" value="product">
      <button class="btn" type="submit">Search</button>
    </form>
    {% if search.performed %}
      {% render 'search-facets' %}
      <p class="sb-sf-count" style="color:var(--muted);margin-bottom:1.25rem">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for “{{ search.terms }}”</p>
      <div class="product-grid" id="ProductGrid-{{ section.id }}" data-page="{{ paginate.current_page }}" data-pages="{{ paginate.pages }}">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'search-card', product: item, pmin: sb_pmin, pmax: sb_pmax %}
          {% endif %}
        {% endfor %}
      </div>
      {% if paginate.pages > 1 and paginate.current_page < paginate.pages %}
        <div
          class="load-more-wrap"
          id="LoadMoreWrap-{{ section.id }}"
          data-next-page="{{ paginate.current_page | plus: 1 }}"
          data-pages="{{ paginate.pages }}"
          style="margin-top:2rem;display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;align-items:center"
        >
          <button type="button" class="btn" id="LoadMore-{{ section.id }}">Load more</button>
          <button type="button" class="btn btn--outline" id="ShowAll-{{ section.id }}">Show all</button>
        </div>
      {% endif %}
    {% else %}
      <p style="color:var(--muted)">Try MAC, Double Wear, or Clinique.</p>
    {% endif %}
  </div>
</section>
{% endpaginate %}

<script>
(function () {
  var sectionId = '{{ section.id }}';
  var root = document.getElementById('SearchSection-' + sectionId);
  var grid = document.getElementById('ProductGrid-' + sectionId);
  var wrap = document.getElementById('LoadMoreWrap-' + sectionId);
  var moreBtn = document.getElementById('LoadMore-' + sectionId);
  var allBtn = document.getElementById('ShowAll-' + sectionId);
  if (!root || !grid || !wrap || !moreBtn) return;

  var MORE_LABEL = 'Load more';
  var ALL_LABEL = 'Show all';
  var LOADING_LABEL = 'Loading…';
  var SHOW_ALL_MAX_PAGES = 400; // 2026-10-05 Dru: Show all loads everything (safety cap only).
  var nextPage = parseInt(wrap.getAttribute('data-next-page'), 10) || 2;
  var lastPage = parseInt(wrap.getAttribute('data-pages'), 10) || 1;
  var busy = false;

  function isDone() { return nextPage > lastPage; }

  function finish() {
    if (wrap.parentNode) wrap.parentNode.removeChild(wrap);
  }

  function setBusy(on, which) {
    busy = on;
    moreBtn.disabled = on;
    moreBtn.textContent = on && which === 'more' ? LOADING_LABEL : MORE_LABEL;
    if (allBtn) {
      allBtn.disabled = on;
      allBtn.textContent = on && which === 'all' ? LOADING_LABEL : ALL_LABEL;
    }
    wrap.setAttribute('aria-busy', on ? 'true' : 'false');
  }

  // Keep every current query param (filters, sort_by, q, type, ...); only swap page + section_id.
  function pageUrl(page) {
    var u = new URL(window.location.href);
    u.searchParams.set('page', String(page));
    u.searchParams.set('section_id', sectionId);
    u.hash = '';
    return u.pathname + u.search;
  }

  // Fetch one page via the Section Rendering API (same section => same card markup and skips) and append its cards.
  function fetchPage(page) {
    return fetch(pageUrl(page), { credentials: 'same-origin' })
      .then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.text();
      })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var nextGrid = doc.getElementById('ProductGrid-' + sectionId);
        if (!nextGrid) {
          // Section rendered but no grid => past the last page. Anything else is an error.
          if (doc.getElementById('SearchSection-' + sectionId)) { lastPage = page - 1; return; }
          throw new Error('Unexpected response');
        }
        var pages = parseInt(nextGrid.getAttribute('data-pages'), 10);
        if (pages) lastPage = pages;
        // Copy to a static array first: appendChild moves nodes out of the live HTMLCollection.
        Array.prototype.slice.call(nextGrid.children).forEach(function (card) {
          grid.appendChild(card);
        });
        nextPage = page + 1;
      });
  }

  if (isDone()) { finish(); return; }

  moreBtn.addEventListener('click', function () {
    if (busy || isDone()) return;
    setBusy(true, 'more');
    fetchPage(nextPage)
      .then(function () {
        setBusy(false);
        if (isDone()) finish();
      })
      .catch(function () {
        setBusy(false); // re-enable so the shopper can retry
      });
  });

  if (allBtn) {
    allBtn.addEventListener('click', function () {
      if (busy || isDone()) return;
      setBusy(true, 'all');
      var fetched = 0;
      (function step() {
        if (isDone()) { setBusy(false); finish(); return; }
        if (fetched >= SHOW_ALL_MAX_PAGES) { setBusy(false); return; }
        fetched += 1;
        allBtn.textContent = 'Loading… ' + Math.min(nextPage, lastPage) + ' / ' + lastPage;
        fetchPage(nextPage).then(step).catch(function () {
          setBusy(false); // re-enable on failure; cards already appended stay
        });
      })();
    });
  }
})();
</script>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
