<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div>
        <p class="kicker">{{ section.settings.kicker }}</p>
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.subtitle != blank %}
          <p style="margin-top:.4rem;color:var(--muted);font-size:.9rem">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
      {% if section.settings.collection %}
        <a href="{{ section.settings.collection.url }}" class="kicker">View all →</a>
      {% endif %}
    </div>
    <div class="product-rail">
      {% assign col = section.settings.collection %}
      {% if col != blank %}
        {% for product in col.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
        {% endfor %}
        <a class="view-all-card" href="{{ col.url }}">View all</a>
      {% else %}
        {% for product in collections.all.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product carousel",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The vault" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Most sold and most watched" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 4, "max": 15, "step": 1, "label": "Products", "default": 15 }
  ],
  "presets": [{ "name": "Product carousel" }]
}
{% endschema %}
