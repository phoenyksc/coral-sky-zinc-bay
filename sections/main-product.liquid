            var byName = {};
            function norm(s) { return (s || '').replace(/\s+/g, ' ').trim(); }
            Object.keys(sets).forEach(function (k) { byName[norm(k)] = sets[k]; });
            function brush(hex) {
              return '<span class="swatch-brush-inline" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 140 56" width="72" height="29" focusable="false"><path fill="' + hex + '" d="M6 34c3-12 14-24 32-26 12-1 22 4 32 10 8 5 16 8 26 6 12-2 22-9 34-10 8-1 16 3 18 10 1 5-3 10-11 12-14 4-28 2-41 6-10 3-18 9-29 10-14 2-26-3-34-12-5-6-8-12-5-16 2-3 5-4 9-4z"/><path fill="' + hex + '" opacity=".55" d="M22 26c8-7 20-11 32-8 10 2 17 7 27 5 12-2 22-7 34-5 7 1 11 5 9 9-2 5-8 7-16 8-14 2-27-1-40 3-9 3-17 7-26 5-8-1-14-6-16-12-1-3 1-5 4-5z"/><path fill="' + hex + '" opacity=".35" d="M40 18c6-3 14-4 20-1 4 2 7 4 12 3 6-1 10-3 15-2 3 0 5 2 4 4-1 2-4 3-8 3-7 1-13 0-19 2-5 1-9 3-14 2-4 0-7-2-8-5 0-2 1-4 2-6z"/></svg></span>';
            }
            function labelOf(btn) {
              var t = (btn.textContent || '').replace(/\s+/g, ' ').trim();
              t = t.replace(/Sold out/ig, '').trim();
              return t;
            }
            function paint(name) {
              var shades = byName[norm(name)];
              if (!shades || !shades.length) {
                row.innerHTML = '';
                if (kicker) kicker.style.display = 'none';
                return;
              }
              if (kicker) kicker.style.display = '';
              row.innerHTML = shades.map(function (pair) {
                return '<div class="swatch swatch--brush" aria-hidden="true">' + brush(pair[1]) + '<span class="swatch-label">' + pair[0] + '</span></div>';
              }).join('');
            }
            function currentBtn() {
              return document.querySelector('.option-grid .swatch.is-active');
            }
            var startBtn = currentBtn();
            paint(startBtn ? labelOf(startBtn) : (row.getAttribute('data-active') || ''));
            document.addEventListener('click', function (e) {
              var btn = e.target.closest && e.target.closest('.option-grid .swatch');
              if (!btn || btn.closest('#sb-inner-shade-row')) return;
              paint(labelOf(btn));
            });
          })();
        </script>
      {% endif %}
      <p class="kicker" id="sb-sku-line" style="margin-top:1rem;{% if current.sku == blank %}display:none{% endif %}">SKU <span id="sb-sku">{{ current.sku }}</span><span id="sb-upc-wrap"{% if current.barcode == blank %} style="display:none"{% endif %}> · UPC <span id="sb-upc">{{ current.barcode }}</span></span></p>
      <script>
        (function () {
          var line = document.getElementById('sb-sku-line');
          var skuEl = document.getElementById('sb-sku');
          var upcEl = document.getElementById('sb-upc');
          var upcWrap = document.getElementById('sb-upc-wrap');
          if (!line || !skuEl) return;
          function apply(btn) {
            var sku = btn.getAttribute('data-sku') || '';
            var upc = btn.getAttribute('data-barcode') || '';
            skuEl.textContent = sku;
            if (upcEl) upcEl.textContent = upc;
            if (upcWrap) upcWrap.style.display = upc ? '' : 'none';
            line.style.display = sku ? '' : 'none';
          }
          document.addEventListener('click', function (e) {
            var btn = e.target.closest && e.target.closest('button.swatch');
            if (!btn) return;
            apply(btn);
          });
        })();
      </script>
      <div class="pdp-actions">
        <input class="qty" type="number" name="quantity" value="1" min="1">
        <button class="btn btn--lg" type="submit"{% unless current.available %} disabled{% endunless %}>
          {% if current.available %}Add to bag{% else %}Sold out{% endif %}
        </button>
      </div>
    {% endform %}
    <ul class="trust">
      <li>Free standard shipping on US orders $75+</li>
      <li>Curated by Sol Beautiful · Ships from the USA</li>
      <li>Authenticity guaranteed</li>
    </ul>
    {% comment %}
      Dru 2026-09-23: trust block once; strip description boilerplate.
    {% endcomment %}
    {% assign pdp_desc = product.description
      | replace: '<p>Sold by Sol Beautiful and ships from the USA.</p>', ''
      | replace: '<p>Sold by Sol Beautiful and ships from the USA</p>', ''
      | replace: '<p>Curated by Sol Beautiful and ships from the USA.</p>', ''
      | replace: '<p>Curated by Sol Beautiful and ships from the USA</p>', ''
      | replace: '<p>Free standard shipping on US orders $75+</p>', ''
      | replace: '<p>Authenticity guaranteed</p>', ''
      | replace: 'Sold by Sol Beautiful and ships from the USA.', ''
      | replace: 'Sold by Sol Beautiful and ships from the USA', ''
      | replace: 'Curated by Sol Beautiful and ships from the USA.', ''
      | replace: 'Curated by Sol Beautiful and ships from the USA', ''
      | replace: 'Sold by Sol Beautiful', ''
      | replace: 'sold by Sol Beautiful', ''
      | replace: 'Curated by Sol Beautiful', ''
      | replace: 'product from Sol Beautiful', 'product'
      | replace: 'products from Sol Beautiful', 'products'
      | replace: ' from Sol Beautiful', ''
    %}
    <div class="rte">{{ pdp_desc }}</div>
  </div>
