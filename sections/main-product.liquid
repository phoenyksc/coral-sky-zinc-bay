<div class="page-width pdp">
  <div class="pdp-media" style="position:relative">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 1400 | image_tag: alt: product.title, loading: 'eager' }}
      {% if sb_disclaimer %}
      <p style="position:absolute;left:12px;right:12px;bottom:8px;margin:0;padding:0;background:transparent;color:rgba(90,84,76,.62);font-family:system-ui,sans-serif;font-size:10px;font-weight:400;line-height:1.3;text-align:center;letter-spacing:.01em">Photo is a stock image and may not match the selected color</p>
      {% endif %}
    {% endif %}
  </div>
  <div>
    <p class="crumbs">
      <a href="{{ routes.root_url }}">Home</a> /
      {% if product.collections.first %}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> /{% endif %}
      {{ product.title }}
    </p>
    {% render 'pdp-manufacturer' %}
    <h1 class="product__title">{{ product.title }}</h1>
    <p data-product-price class="card-price" style="margin-top:1rem;font-size:1.15rem">
      {{ current.price | money }}
      {% if current.compare_at_price > current.price %}
        <span class="compare">{{ current.compare_at_price | money }}</span>
      {% endif %}
    </p>
    {% if current.inventory_quantity > 0 and current.inventory_quantity < 6 %}
      <p class="badge badge--low" style="position:static;display:inline-block;margin-top:1rem">Low inventory · {{ current.inventory_quantity }} in warehouse</p>
    {% endif %}
    {% form 'product', product, data-product-form: '' %}
      <input type="hidden" name="id" value="{{ current.id }}">

      {% if product.has_only_default_variant %}
        {% comment %} Single-shade: still show one chip {% endcomment %}
        {% assign sold_out = false %}
