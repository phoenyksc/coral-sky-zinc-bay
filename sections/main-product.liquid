{% assign current = product.selected_or_first_available_variant %}
{% comment %}
  2026-09-28 Dru/Eve: brush-stroke color swatches on ALL PDPs (multi + single shade).
  Color-like option names → brush-stroke inline SVG + label. OOS grey like prior lock.
  Single default-variant products still show one chip (Shade).
  Hex: variant.metafields.custom.swatch_hex → else pilot snippet map → else #c8c4bc.
  NO Shopify media upload required for brush swatches.
{% endcomment %}
<div class="page-width pdp">
  <div class="pdp-media">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 1400 | image_tag: alt: product.title, loading: 'eager' }}
    {% endif %}
  </div>
  <div>
    <p class="crumbs">
      <a href="{{ routes.root_url }}">Home</a> /
      {% if product.collections.first %}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> /{% endif %}
      {{ product.title }}
    </p>
    {% render 'pdp-manufacturer' %}
    <h1 class="product__title">{{ product.title }}</h1>
    <p data-product-price class="card-price" style="margin-top:1rem;font-size:1.15rem">
      {{ current.price | money }}
      {% if current.compare_at_price > current.price %}
        <span class="compare">{{ current.compare_at_price | money }}</span>
      {% endif %}
    </p>
    {% if current.inventory_quantity > 0 and current.inventory_quantity < 6 %}
      <p class="badge badge--low" style="position:static;display:inline-block;margin-top:1rem">Low inventory · {{ current.inventory_quantity }} in warehouse</p>
    {% endif %}
    {% form 'product', product, data-product-form: '' %}
      <input type="hidden" name="id" value="{{ current.id }}">

      {% if product.has_only_default_variant %}
        {% comment %} Single-shade: still show one chip {% endcomment %}
        {% assign sold_out = false %}
        {% unless current.available %}{% assign sold_out = true %}{% endunless %}
        {% if current.inventory_management != blank and current.inventory_quantity <= 0 and current.inventory_policy != 'continue' %}
          {% assign sold_out = true %}
        {% endif %}
        {% assign shade_label = current.title %}
        {% if shade_label == 'Default Title' %}
          {% assign shade_label = 'Shade' %}
        {% endif %}
        {% assign chip_hex = current.metafields.custom.swatch_hex.value | default: current.metafields.custom.swatch_hex %}
        {% if chip_hex == blank %}
          {% capture chip_hex %}{% render 'swatch-hex', shade: shade_label, product_title: product.title %}{% endcapture %}
          {% assign chip_hex = chip_hex | strip %}
        {% endif %}
        {% if chip_hex == blank %}{% assign chip_hex = '#c8c4bc' %}{% endif %}
        <p class="kicker" style="margin-top:1rem">Shade</p>
        <div class="option-grid option-grid--brush">
          <button
            type="button"
            class="swatch swatch--brush is-active{% if sold_out %} is-soldout{% endif %}"
            data-variant-id="{{ current.id }}"
            data-available="{% if sold_out %}false{% else %}true{% endif %}"
            data-price="{{ current.price | money }}"
            data-hex="{{ chip_hex }}"
            aria-label="{{ shade_label }}"
            {% if sold_out %}aria-disabled="true" disabled{% endif %}
          >
            {% render 'swatch-brush', hex: chip_hex %}
            <span class="swatch-label">{{ shade_label }}</span>
            {% if sold_out %}<span class="swatch-soldout">Sold out</span>{% endif %}
          </button>
        </div>
      {% else %}
        {% comment %} Dru 2026-09-22 / Grok Build: all variants visible; OOS greyed; never page Sold Out if any in stock {% endcomment %}
        {% if product.options.size == 1 %}
          {% assign opt_name = product.options.first %}
          {% assign opt_down = opt_name | downcase %}
          {% assign is_color_opt = false %}
          {% if opt_down contains 'color' or opt_down contains 'colour' or opt_down contains 'shade' or opt_down == 'style' or opt_down contains 'product color' or opt_down contains 'kit color' %}
            {% assign is_color_opt = true %}
          {% endif %}
          <p class="kicker" style="margin-top:1rem">{{ opt_name }}</p>
          <div class="option-grid{% if is_color_opt %} option-grid--brush{% endif %}">
            {% for variant in product.variants %}
              {% assign sold_out = false %}
              {% unless variant.available %}{% assign sold_out = true %}{% endunless %}
              {% if variant.inventory_management != blank and variant.inventory_quantity <= 0 and variant.inventory_policy != 'continue' %}
                {% assign sold_out = true %}
              {% endif %}
              {% assign shade_label = variant.title %}
              {% assign chip_hex = variant.metafields.custom.swatch_hex.value | default: variant.metafields.custom.swatch_hex %}
              {% if chip_hex == blank and is_color_opt %}
                {% capture chip_hex %}{% render 'swatch-hex', shade: shade_label, product_title: product.title %}{% endcapture %}
                {% assign chip_hex = chip_hex | strip %}
              {% endif %}
              {% if chip_hex == blank %}{% assign chip_hex = '#c8c4bc' %}{% endif %}
              <button
                type="button"
                class="swatch{% if is_color_opt %} swatch--brush{% endif %}{% if variant.id == current.id %} is-active{% endif %}{% if sold_out %} is-soldout{% endif %}"
                data-variant-id="{{ variant.id }}"
                data-available="{% if sold_out %}false{% else %}true{% endif %}"
                data-price="{{ variant.price | money }}"
                {% if variant.compare_at_price > variant.price %}data-compare="{{ variant.compare_at_price | money }}"{% endif %}
                {% if is_color_opt %}data-hex="{{ chip_hex }}" aria-label="{{ shade_label }}"{% endif %}
                {% if sold_out %}aria-disabled="true" disabled{% endif %}
              >
                {% if is_color_opt %}
                  {% render 'swatch-brush', hex: chip_hex %}
                  <span class="swatch-label">{{ shade_label }}</span>
                {% else %}
                  {{ shade_label }}
                {% endif %}
                {% if sold_out %}<span class="swatch-soldout">Sold out</span>{% endif %}
              </button>
            {% endfor %}
          </div>
        {% else %}
          {% for option in product.options_with_values %}
            {% assign opt_down = option.name | downcase %}
            {% assign is_color_opt = false %}
            {% if opt_down contains 'color' or opt_down contains 'colour' or opt_down contains 'shade' or opt_down == 'style' or opt_down contains 'product color' or opt_down contains 'kit color' %}
              {% assign is_color_opt = true %}
            {% endif %}
            <div class="option-block" data-option-index="{{ forloop.index0 }}">
              <p class="kicker">{{ option.name }}</p>
              <div class="option-grid{% if is_color_opt %} option-grid--brush{% endif %}">
                {% for value in option.values %}
                  {% assign value_available = false %}
                  {% assign matched_variant = nil %}
                  {% for variant in product.variants %}
                    {% assign opt_match = false %}
                    {% if option.position == 1 and variant.option1 == value %}
                      {% assign opt_match = true %}
                    {% elsif option.position == 2 and variant.option2 == value %}
                      {% assign opt_match = true %}
                    {% elsif option.position == 3 and variant.option3 == value %}
                      {% assign opt_match = true %}
                    {% endif %}
                    {% if opt_match %}
                      {% if matched_variant == nil %}{% assign matched_variant = variant %}{% endif %}
                      {% assign v_sold = false %}
                      {% unless variant.available %}{% assign v_sold = true %}{% endunless %}
                      {% if variant.inventory_management != blank and variant.inventory_quantity <= 0 and variant.inventory_policy != 'continue' %}
                        {% assign v_sold = true %}
                      {% endif %}
                      {% unless v_sold %}
                        {% assign value_available = true %}
                        {% assign matched_variant = variant %}
                      {% endunless %}
                    {% endif %}
                  {% endfor %}
                  {% assign sold_out = true %}
                  {% if value_available %}{% assign sold_out = false %}{% endif %}
                  {% assign chip_hex = matched_variant.metafields.custom.swatch_hex.value | default: matched_variant.metafields.custom.swatch_hex %}
                  {% if chip_hex == blank and is_color_opt %}
                    {% capture chip_hex %}{% render 'swatch-hex', shade: value, product_title: product.title %}{% endcapture %}
                    {% assign chip_hex = chip_hex | strip %}
                  {% endif %}
                  {% if chip_hex == blank %}{% assign chip_hex = '#c8c4bc' %}{% endif %}
                  <button
                    type="button"
                    class="swatch{% if is_color_opt %} swatch--brush{% endif %}{% if matched_variant and matched_variant.id == current.id %} is-active{% endif %}{% if sold_out %} is-soldout{% endif %}"
                    data-variant-id="{{ matched_variant.id }}"
                    data-available="{% if sold_out %}false{% else %}true{% endif %}"
                    data-price="{{ matched_variant.price | money }}"
                    {% if matched_variant.compare_at_price > matched_variant.price %}data-compare="{{ matched_variant.compare_at_price | money }}"{% endif %}
                    {% if is_color_opt %}data-hex="{{ chip_hex }}" aria-label="{{ value }}"{% endif %}
                    {% if sold_out %}aria-disabled="true" disabled{% endif %}
                  >
                    {% if is_color_opt %}
                      {% render 'swatch-brush', hex: chip_hex %}
                      <span class="swatch-label">{{ value }}</span>
                    {% else %}
                      {{ value }}
                    {% endif %}
                    {% if sold_out %}<span class="swatch-soldout">Sold out</span>{% endif %}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endif %}
      {% endif %}

      {% if current.sku != blank %}
        <p class="kicker" style="margin-top:1rem">SKU {{ current.sku }}{% if current.barcode != blank %} · UPC {{ current.barcode }}{% endif %}</p>
      {% endif %}
      <div class="pdp-actions">
        <input class="qty" type="number" name="quantity" value="1" min="1">
        <button class="btn btn--lg" type="submit"{% unless current.available %} disabled{% endunless %}>
          {% if current.available %}Add to bag{% else %}Sold out{% endif %}
        </button>
      </div>
    {% endform %}
    <ul class="trust">
      <li>Free standard shipping on US orders $75+</li>
      <li>Curated by Sol Beautiful · Ships from the USA</li>
      <li>Authenticity guaranteed</li>
    </ul>
    {% comment %}
      Dru 2026-09-23: trust block once; strip description boilerplate.
    {% endcomment %}
    {% assign pdp_desc = product.description
      | replace: '<p>Sold by Sol Beautiful and ships from the USA.</p>', ''
      | replace: '<p>Sold by Sol Beautiful and ships from the USA</p>', ''
      | replace: '<p>Curated by Sol Beautiful and ships from the USA.</p>', ''
      | replace: '<p>Curated by Sol Beautiful and ships from the USA</p>', ''
      | replace: '<p>Free standard shipping on US orders $75+</p>', ''
      | replace: '<p>Authenticity guaranteed</p>', ''
      | replace: 'Sold by Sol Beautiful and ships from the USA.', ''
      | replace: 'Sold by Sol Beautiful and ships from the USA', ''
      | replace: 'Curated by Sol Beautiful and ships from the USA.', ''
      | replace: 'Curated by Sol Beautiful and ships from the USA', ''
      | replace: 'Sold by Sol Beautiful', ''
      | replace: 'sold by Sol Beautiful', ''
      | replace: 'Curated by Sol Beautiful', ''
      | replace: 'product from Sol Beautiful', 'product'
      | replace: 'products from Sol Beautiful', 'products'
      | replace: ' from Sol Beautiful', ''
    %}
    <div class="rte">{{ pdp_desc }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
