{%- comment -%}
  Sol Beautiful — LOOK PAGE (template page.look). 2026-10-12.
  Page handle look-<key> → row from snippets/look-map. Renders campaign still, headline, subtext and
  ALL of the look's in-stock products (sold-out skipped), each card links to its PDP.
  2026-10-12 parity A4: first screen also shows a product strip (image, brand, price) + total and
  "Add all N to bag" (Ajax POST /cart/add.js, items[] = first available variant of each in-stock product).
{%- endcomment -%}
{%- assign lp_key = page.handle | remove_first: 'look-' -%}
{%- capture lp_row -%}{%- render 'look-map', key: lp_key -%}{%- endcapture -%}
{%- assign lp_row = lp_row | strip -%}
<div class="sb-look-page" id="LP-{{ section.id }}">
<style>
  #LP-{{ section.id }}{background:#fff}
  #LP-{{ section.id }} .lp-hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);color:var(--lp-ink,#fff);background:var(--lp-panel,#2a1838)}
  #LP-{{ section.id }} .lp-media{aspect-ratio:9/8;overflow:hidden;background:#111}
  #LP-{{ section.id }} .lp-media img{width:100%;height:100%;object-fit:cover;object-position:center 20%;display:block}
  #LP-{{ section.id }} .lp-copy{display:flex;flex-direction:column;justify-content:center;gap:.5rem;padding:clamp(1.2rem,4vw,3.5rem)}
  #LP-{{ section.id }} .lp-eyebrow{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;opacity:.8;margin:0}
  #LP-{{ section.id }} .lp-h{font-size:clamp(1.8rem,4vw,3rem);line-height:1.05;margin:0;color:inherit}
  #LP-{{ section.id }} .lp-sub{margin:0;font-size:1rem;opacity:.92}
  #LP-{{ section.id }} .lp-count{margin:.4rem 0 0;font-weight:700;font-size:.9rem}
  #LP-{{ section.id }} .lp-jump{align-self:flex-start;margin-top:.6rem;background:#fff;color:#1a1a1a;font-weight:700;padding:.7rem 1.2rem;border-radius:999px;text-decoration:none;font-size:.9rem}
  #LP-{{ section.id }} .lp-grid-wrap{padding:1.25rem 0 1.75rem}
  #LP-{{ section.id }} .lp-grid-wrap h2{margin:0 0 .75rem;font-size:1.25rem}
  #LP-{{ section.id }} .lp-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  #LP-{{ section.id }} .sb-look-card .card-media{position:relative}
  #LP-{{ section.id }} .sb-look-card{display:flex;flex-direction:column;gap:.25rem;text-decoration:none;color:inherit;min-width:0}
  #LP-{{ section.id }} .sb-look-card .card-media img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:contain;background:#fff;border-radius:4px}
  #LP-{{ section.id }} .sb-look-card .card-title{font-size:.85rem;line-height:1.3;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  #LP-{{ section.id }} .sb-look-card .card-price{font-weight:700;margin:0;font-size:.9rem}
  #LP-{{ section.id }} .sb-look-badge{position:absolute;top:6px;left:6px;font-size:.62rem;font-weight:700;padding:2px 6px;border-radius:3px;background:#f2c14e;color:#1a1a1a}
  #LP-{{ section.id }} .lp-back{display:inline-block;margin-top:1rem;font-size:.9rem;color:inherit}
  #LP-{{ section.id }} .lp-strip{list-style:none;margin:.6rem 0 0;padding:0;display:flex;flex-direction:column;gap:.45rem}
  #LP-{{ section.id }} .lp-strip a{display:grid;grid-template-columns:52px minmax(0,1fr);gap:.65rem;align-items:center;background:rgba(255,255,255,.96);color:#1a1a1a;border-radius:8px;padding:.35rem .6rem .35rem .35rem;text-decoration:none}
  #LP-{{ section.id }} .lp-strip img{width:52px;height:52px;object-fit:contain;background:#fff;border-radius:6px;display:block}
  #LP-{{ section.id }} .lp-strip li{min-width:0}
  #LP-{{ section.id }} .lp-s-txt{min-width:0;line-height:1.2}
  #LP-{{ section.id }} .lp-s-brand{display:block;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  #LP-{{ section.id }} .lp-s-title{display:block;font-size:.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #LP-{{ section.id }} .lp-s-price{font-weight:700;font-size:.85rem}
  #LP-{{ section.id }} .lp-actions{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;margin-top:.7rem}
  #LP-{{ section.id }} .lp-addall{background:#fff;color:#1a1a1a;border:0;font:inherit;font-weight:700;padding:.75rem 1.3rem;border-radius:999px;cursor:pointer;font-size:.92rem}
  #LP-{{ section.id }} .lp-addall[disabled]{opacity:.65;cursor:default}
  #LP-{{ section.id }} .lp-total{font-size:.85rem;opacity:.9}
  #LP-{{ section.id }} .lp-msg{flex-basis:100%;margin:0;font-size:.85rem;min-height:1.1em}
  #LP-{{ section.id }} .lp-msg a{color:inherit;font-weight:700}
  #LP-{{ section.id }} .lp-actions .lp-jump{margin-top:0;background:transparent;color:inherit;border:1px solid rgba(255,255,255,.7)}
  @media(max-width:749px){
    #LP-{{ section.id }} .lp-strip{flex-direction:row;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
    #LP-{{ section.id }} .lp-strip::-webkit-scrollbar{display:none}
    #LP-{{ section.id }} .lp-strip li{flex:0 0 82%;min-width:0;scroll-snap-align:start}
    #LP-{{ section.id }} .lp-copy{min-width:0}
    #LP-{{ section.id }} .lp-actions{margin-top:.5rem}
    #LP-{{ section.id }} .lp-media{aspect-ratio:16/10}
    #LP-{{ section.id }} .lp-hero{grid-template-columns:minmax(0,1fr)}
    #LP-{{ section.id }} .lp-copy{padding:1rem 1rem 1.2rem}
    #LP-{{ section.id }} .lp-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  }
  /* 2026-10-13 Dru: look grid 25% smaller + tighter; phones = one swipe row (no lone orphan card) */
  #LP-{{ section.id }} .lp-grid-wrap#LookProducts{padding:.9rem 0 1rem}
  #LP-{{ section.id }} #LookProducts h2{margin:0 0 .5rem;font-size:1.1rem}
  #LP-{{ section.id }} #LookProducts .lp-grid{gap:10px;max-width:75%}
  #LP-{{ section.id }} #LookProducts .sb-look-card{gap:.15rem}
  #LP-{{ section.id }} #LookProducts .card-vendor{font-size:.62rem;margin:0;line-height:1.2}
  #LP-{{ section.id }} #LookProducts .sb-look-card .card-title{font-size:.72rem;line-height:1.25}
  #LP-{{ section.id }} #LookProducts .sb-look-card .card-price{font-size:.7rem}
  @media(max-width:749px){
    #LP-{{ section.id }} #LookProducts .lp-grid{display:flex;max-width:none;gap:8px;overflow-x:auto;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:2px}
    #LP-{{ section.id }} #LookProducts .lp-grid::-webkit-scrollbar{display:none}
    #LP-{{ section.id }} #LookProducts .lp-grid > .sb-look-card{flex:0 0 calc((100% - 8px) / 2 * .75);scroll-snap-align:start}
  }
</style>
{%- if lp_row == blank -%}
  <div class="page-width lp-grid-wrap"><h1>{{ page.title }}</h1>{{ page.content }}<a class="lp-back" href="/collections/popular">Shop Popular</a></div>
{%- else -%}
  {%- assign lp = lp_row | split: '::' -%}
  {%- assign lp_handles = lp[5] | split: ',' -%}
  {%- assign lp_n = 0 -%}
  {%- assign lp_total = 0 -%}
  {%- assign lp_ids = '' -%}
  {%- capture lp_strip -%}
    {%- for h in lp_handles -%}
      {%- assign p = all_products[h] -%}
      {%- if p == blank or p.available == false or p.featured_media == blank -%}{%- continue -%}{%- endif -%}
      {%- assign v = p.selected_or_first_available_variant -%}
      {%- if v.available == false -%}{%- continue -%}{%- endif -%}
      {%- assign lp_total = lp_total | plus: v.price -%}
      {%- assign lp_ids = lp_ids | append: v.id | append: ',' -%}
      {%- assign s_mfr = p.metafields.custom.manufacturer.value | default: p.metafields.custom.manufacturer -%}
      {%- assign s_m = s_mfr | downcase -%}
      {%- if s_mfr == blank or s_m contains 'escentshow' or s_m contains 'ebay' -%}{%- assign s_mfr = '' -%}{%- endif -%}
      {%- assign s_href = p.url -%}{%- if s_href == blank -%}{%- assign s_href = '/products/' | append: p.handle -%}{%- endif -%}
      <li><a href="{{ s_href }}">
        <img src="{{ p.featured_media | image_url: width: 120 }}" alt="" width="52" height="52" loading="eager">
        <span class="lp-s-txt">{%- if s_mfr != blank -%}<span class="lp-s-brand">{{ s_mfr }}</span>{%- endif -%}<span class="lp-s-title">{{ p.title }}</span></span>
        {%- comment -%} 2026-10-15 Dru rule: no prices in the hero (price lives on the cards below) {%- endcomment -%}
      </a></li>
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign lp_ids = lp_ids | split: ',' -%}
  {%- capture lp_cards -%}
    {%- for h in lp_handles -%}
      {%- assign p = all_products[h] -%}
      {%- if p == blank or p.available == false or p.featured_media == blank -%}{%- continue -%}{%- endif -%}
      {%- if lp_n == 0 -%}{%- assign lp_badge = lp[6] -%}{%- else -%}{%- assign lp_badge = '' -%}{%- endif -%}
      {%- render 'look-card', p: p, badge: lp_badge -%}
      {%- assign lp_n = lp_n | plus: 1 -%}
    {%- endfor -%}
  {%- endcapture -%}
  <section class="lp-hero" style="--lp-panel:{{ lp[4] }};--lp-ink:#fff">
    <div class="lp-media">
      {%- assign lp_img = images[lp[3]] -%}
      {%- if lp_img != blank -%}{{ lp_img | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600,900,1400', sizes: '(min-width: 750px) 55vw, 100vw', alt: lp[1] }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
    </div>
    <div class="lp-copy">
      <p class="lp-eyebrow">The Halloween Makeup Edit</p>
      <h1 class="lp-h">{{ lp[1] }}</h1>
      <p class="lp-sub">{{ lp[2] }}</p>
      <p class="lp-count">{{ lp_n }} {% if lp_n == 1 %}product{% else %}products{% endif %} in this look</p>
      {%- if lp_ids.size > 0 -%}
      <ul class="lp-strip" aria-label="Products in {{ lp[1] | escape }}">{{ lp_strip }}</ul>
      <div class="lp-actions">
        <button type="button" class="lp-addall" data-ids="{{ lp_ids | join: ',' }}">Add all {{ lp_ids.size }} to bag</button>
        <a class="lp-jump" href="#LookProducts">See details</a>
        <p class="lp-msg" role="status" aria-live="polite"></p>
      </div>
      {%- else -%}
      <a class="lp-jump" href="#LookProducts">Shop the look</a>
      {%- endif -%}
    </div>
  </section>
  <div class="page-width lp-grid-wrap" id="LookProducts">
    <h2>Everything in {{ lp[1] }}</h2>
    {%- if lp_n > 0 -%}<div class="lp-grid product-grid">{{ lp_cards }}</div>{%- else -%}<p>This look is sold out right now. <a href="/collections/popular">Shop Popular</a></p>{%- endif -%}
    <a class="lp-back" href="/#shopify-section-hero">&larr; All Halloween looks</a>
  </div>
  {%- comment -%} 2026-10-13: reusable 'You might be interested in' rail (snippets/look-ymal) {%- endcomment -%}
  {%- render 'look-ymal', handles: lp[5], name: lp[1] -%}
{%- endif -%}
</div>
<script>
(function(){
  var root=document.getElementById('LP-{{ section.id }}'); if(!root) return;
  var btn=root.querySelector('.lp-addall'); if(!btn) return;
  var msg=root.querySelector('.lp-msg'); var label=btn.textContent;
  btn.addEventListener('click',function(){
    var ids=(btn.getAttribute('data-ids')||'').split(',').filter(Boolean);
    if(!ids.length) return;
    btn.disabled=true; btn.textContent='Adding…'; msg.textContent='';
    fetch('{{ routes.cart_add_url }}.js',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify({items:ids.map(function(id){return {id:Number(id),quantity:1};})})})
    .then(function(r){return r.json().then(function(j){if(!r.ok) throw j; return j;});})
    .then(function(j){
      var n=(j.items||[]).length;
      btn.textContent='Added ✓';
      msg.innerHTML=n+' item'+(n==1?'':'s')+' added to your bag. <a href="{{ routes.cart_url }}">View bag</a>';
      document.dispatchEvent(new CustomEvent('cart:refresh',{bubbles:true}));
      fetch('{{ routes.cart_url }}.js',{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(c){
        document.querySelectorAll('[data-cart-count],.cart-count,.cart-count-bubble span').forEach(function(el){el.textContent=c.item_count;});
      }).catch(function(){});
      setTimeout(function(){btn.disabled=false;btn.textContent=label;},2500);
    })
    .catch(function(e){
      btn.disabled=false; btn.textContent=label;
      msg.textContent=(e&&e.description)?e.description:'Sorry, we couldn’t add these. Please add them one by one below.';
    });
  });
})();
</script>
{% schema %}
{ "name": "Look page", "tag": "section", "class": "section-look-page", "settings": [] }
{% endschema %}
