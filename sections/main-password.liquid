
{% comment %}
  Sol Beautiful — password gate main section (DRAFT).
  Do NOT push live / publish without Sol Beautiful + Dru OK.
  Fixes blank <main id="MainContent"> on /password by rendering storefront_password.
  Aesthetic: cream (--bg), Cormorant Garamond + Outfit (live theme base.css).
{% endcomment %}

<section class="password-gate section" id="MainPassword" {{ section.shopify_attributes }}>
  <div class="page-width-narrow password-gate__inner">
    {% if section.settings.use_hero_asset %}
      <div class="password-gate__hero">
        <img
          src="{{ 'hero.jpg' | asset_url }}"
          alt="{{ shop.name }}"
          width="1600"
          height="700"
          loading="eager"
        >
        <span class="password-gate__hero-veil" aria-hidden="true"></span>
      </div>
    {% endif %}

    <p class="kicker">{{ section.settings.kicker }}</p>
    <h1 class="password-gate__heading">{{ section.settings.heading }}</h1>
    {% if section.settings.lede != blank %}
      <p class="password-gate__lede">{{ section.settings.lede }}</p>
    {% endif %}

    <div class="password-gate__card">
      {% form 'storefront_password', class: 'password-form' %}
        {% if form.errors %}
          <div class="password-gate__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <label class="visually-hidden" for="Password-{{ section.id }}">
          {{ section.settings.password_label }}
        </label>
        <div class="password-form__row">
          <input
            class="field"
            type="password"
            name="password"
            id="Password-{{ section.id }}"
            autocomplete="current-password"
            placeholder="{{ section.settings.password_placeholder }}"
            required
          >
          <button class="btn" type="submit">
            {{ section.settings.submit_label }}
          </button>
        </div>
      {% endform %}
    </div>

    {% if section.settings.show_newsletter %}
      <div class="password-gate__newsletter">
        <h2>{{ section.settings.newsletter_heading }}</h2>
        {% if section.settings.newsletter_lede != blank %}
          <p class="password-gate__newsletter-lede">{{ section.settings.newsletter_lede }}</p>
        {% endif %}

        {% form 'customer', class: 'password-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="prospect,password page">
          <label class="visually-hidden" for="Email-{{ section.id }}">Email</label>
          <div class="password-form__row">
            <input
              class="field"
              type="email"
              name="contact[email]"
              id="Email-{{ section.id }}"
              autocomplete="email"
              placeholder="{{ section.settings.newsletter_placeholder }}"
              required
            >
            <button class="btn btn--outline" type="submit">
              {{ section.settings.newsletter_submit }}
            </button>
          </div>
          {% if form.posted_successfully? %}
            <p class="password-gate__ok">Thanks — we will be in touch.</p>
          {% endif %}
          {% if form.errors %}
            <div class="password-gate__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .password-gate__inner { padding: 3.5rem 0 5rem; }
  .password-gate__hero {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 7;
    margin-bottom: 2rem;
    background: var(--card);
  }
  .password-gate__hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }
  .password-gate__hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(242,239,230,.85), rgba(242,239,230,.15) 55%, transparent);
  }
  .password-gate__heading {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin-top: .75rem;
  }
  .password-gate__lede {
    margin-top: 1rem;
    color: color-mix(in srgb, var(--fg) 75%, transparent);
  }
  .password-gate__card {
    margin-top: 2rem;
    padding: 1.5rem;
    border-radius: 12px;
    background: var(--card);
    border: 1px solid var(--line);
  }
  .password-form__row {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }
  .password-form__row .field { flex: 1; min-width: 12rem; }
  .password-gate__errors {
    margin-bottom: 1rem;
    color: var(--sale);
    font-size: .9rem;
  }
  .password-gate__newsletter {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .password-gate__newsletter h2 { font-size: 1.75rem; }
  .password-gate__newsletter-lede {
    margin-top: .5rem;
    color: var(--muted);
    font-size: .95rem;
  }
  .password-newsletter-form { margin-top: 1rem; }
  .password-gate__ok {
    width: 100%;
    margin-top: .75rem;
    color: var(--muted);
    font-size: .9rem;
  }
</style>

{% schema %}
{
  "name": "Password form",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Coming soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The vault is nearly open" },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro",
      "default": "A family-run California vault of designer fragrance, makeup, and skincare — forty years of care. Enter the storefront password to browse."
    },
    { "type": "text", "id": "password_label", "label": "Password label", "default": "Storefront password" },
    { "type": "text", "id": "password_placeholder", "label": "Password placeholder", "default": "Password" },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "Enter" },
    { "type": "checkbox", "id": "use_hero_asset", "label": "Show hero.jpg strip", "default": true },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Get word when we open" },
    {
      "type": "textarea",
      "id": "newsletter_lede",
      "label": "Newsletter intro",
      "default": "Leave your email for launch notes and first-look access."
    },
    { "type": "text", "id": "newsletter_placeholder", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "newsletter_submit", "label": "Newsletter submit", "default": "Notify me" }
  ]
}
{% endschema %}

