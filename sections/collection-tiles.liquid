<section class="collection-tiles page-width"><div class="collection-tiles__grid">{% for block in section.blocks %}{% assign collection = collections[block.settings.collection_handle] %}<a class="collection-tile" href="{{ collection.url }}" {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span></a>{% endfor %}</div></section>{% schema %}{"name":"Collection tiles","blocks":[{"type":"tile","name":"Tile","settings":[{"type":"text","id":"label","label":"Label"},{"type":"text","id":"collection_handle","label":"Collection handle"}]}]}{% endschema %}