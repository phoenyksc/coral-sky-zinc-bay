{% comment %}
  Homepage collection tiles.
{% endcomment %}
<section class="section" id="collection-tiles">
  <div class="page-width">
    <div class="section-head">
      <div>
            <p class="kicke">{{ section.settings.kicker | default: 'Shop by category' }}</p>
                <h2>{{ section.settings.heading | default: 'Collections' }}</h2>
                  </div>
                    </div>
                    <div class="collection-tiles">
                      {% for block in section.blocks %}
                                {% assign handle = block.settings.collection_handle | strip | default: block.settings.collection.handle %}
                                    {% assign col = collections[handle] %}
                                        {% if block.settings.collection != blank %}
                                                      {% assign col = block.settings.collection %}
                                        {% endif %}
                                            {% assign label = block.settings.label %}
                                                {% if label == blank and col != blank %}
                                                              {% assign label = col.title %}
                                                {% endif %}
                                                    {% if label == blank %}
                                                                  {% assign label = handle | replace: '-', ' ' | capitalize %}
                                                    {% endif %}
                                                        {% assign href = '/collections/' | append: handle %}
                                                            {% if col != blank %}
                                                                          {% assign href = col.url %}
                                                            {% endif %}
                                                                <a class="tile" href="{{ href }}" {{ block.shopify_attributes }}>
                                                                      {% if block.settings.image != blank %}
                                                                                    {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: label }}
                                                                      {% elsif col.image != blank %}
                                                                                    {{ col.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: label }}
                                                                      {% elsif col.products.first.featured_media != blank %}
                                                                                    {{ col.products.first.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', alt: label }}
                                                                      {% elsif col.products.first.featured_image != blank %}
                                                                                    {{ col.products.first.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: label }}
                                                                      {% else %}
                                                                                    <div class="tile-veil" style="position:absolute;inset:0;background:var(--wash);"></div>
                                                                      {% endif %}
                                                                              <span class="tile-veil" aria-hidden="true"></span>
                                                                                      <span>{{ label }}</span>
                                                                                            </a>
                                                                    {% endfor %}
                                                                    </div>
                                                                  </div>
                                                                </section>
                                                            
                                                            {% schema %}
                                                        {
                                                          "name": "Collection tiles",
                                                          "tag": "section",
                                                          "class": "section-collection-tiles",
                                                          "settings": [
                                                                { "type": "text", "id": "kicker", "label": "Kicker", "default": "Shop by category" },
                                                                { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
                                                          ],
                                                          "blocks": [
                                                                {
                                                                      "type": "tile",
                                                                          "name": "Tile",
                                                                              "settings": [
                                                                                        { "type": "text", "id": "label", "label": "Label" },
                                                                                            { "type": "text", "id": "collection_handle", "label": "Collection handle", "info": "e.g. fragrances, makeup, skincare, hair, bath-body, hard-to-find" },
                                                                                                { "type": "collection", "id": "collection", "label": "Collection (optional override)" },
                                                                                                    { "type": "image_picker", "id": "image", "label": "Custom image (optional)" }
                                                                              ]
                                                                                }
                                                          ],
                                                          "presets": [
                                                                {
                                                                      "name": "Collection tiles",
                                                                          "blocks": [
                                                                                    { "type": "tile", "settings": { "label": "Fragrances", "collection_handle": "fragrances" } },
                                                                                        { "type": "tile", "settings": { "label": "Makeup", "collection_handle": "makeup" } },
                                                                                            { "type": "tile", "settings": { "label": "Skincare", "collection_handle": "skincare" } },
                                                                                                { "type": "tile", "settings": { "label": "Hair", "collection_handle": "hair" } },
                                                                                                    { "type": "tile", "settings": { "label": "Bath & body", "collection_handle": "bath-body" } },
                                                                                                        { "type": "tile", "settings": { "label": "Hard to find", "collection_handle": "hard-to-find" } }
                                                                                                          ]
                                                                                                            }
                                                          ]
                                                        }
                                                    {% endschema %}}