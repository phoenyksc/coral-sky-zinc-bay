{% comment %}
  Vault rails — homepage product carousels with first-scroll dedupe.
  One section owns all four rails so `seen_ids` can span popular → beauty-sets →
  rare-hard-to-find → low-inventory. First `visible_limit` cards per rail skip
  any product id already shown in an earlier rail's visible window.
  Prefer products with featured_media; fill without-media only if still short.
{% endcomment %}

{% assign seen_ids = ',' %}
{% assign visible_limit = section.settings.visible_limit | default: 5 %}
{% assign products_per_rail = section.settings.products_per_rail | default: 12 %}

{% for block in section.blocks %}
  {% if block.type != 'rail' %}{% continue %}{% endif %}

  {% assign handle = block.settings.collection_handle | strip %}
  {% if handle == blank and block.settings.collection != blank %}
    {% assign handle = block.settings.collection.handle %}
  {% endif %}
  {% assign col = collections[handle] %}
  {% if block.settings.collection != blank %}
    {% assign col = block.settings.collection %}
  {% endif %}

  {% assign heading = block.settings.heading %}
  {% if heading == blank and col != blank %}
    {% assign heading = col.title %}
  {% endif %}
  {% if heading == blank %}
    {% assign heading = handle | replace: '-', ' ' | capitalize %}
  {% endif %}
  {% assign subheading = block.settings.subheading %}

  {% assign href = '/collections/' | append: handle %}
  {% if col != blank %}
    {% assign href = col.url %}
  {% endif %}

  <section class="section vault-rail" id="vault-rail-{{ block.id }}" {{ block.shopify_attributes }}>
    <div class="page-width">
      <div class="section-head">
        <div>
          {% if subheading != blank %}
            <p class="kicker">{{ subheading }}</p>
          {% endif %}
          <h2>{{ heading }}</h2>
        </div>
        {% if handle != blank %}
          <a class="kicker" href="{{ href }}">View all</a>
        {% endif %}
      </div>

      {% if col == blank or col.products_count == 0 %}
        <p class="prose" style="font-size:.9rem;color:var(--muted)">Collection empty or not found ({{ handle }}).</p>
      {% else %}
        <div class="product-rail" data-vault-rail="{{ handle }}" data-visible-limit="{{ visible_limit }}">
          {% assign rail_shown = 0 %}
          {% assign rail_ids = ',' %}

          {% comment %} Pass 1 — visible window, with media, cross-rail unique {% endcomment %}
          {% for product in col.products limit: 50 %}
            {% if rail_shown >= visible_limit %}{% break %}{% endif %}
            {% unless product.featured_media %}{% continue %}{% endunless %}
            {% assign id_token = product.id | prepend: ',' | append: ',' %}
            {% if seen_ids contains id_token %}{% continue %}{% endif %}
            {% if rail_ids contains id_token %}{% continue %}{% endif %}

            <a class="card" href="{{ product.url }}">
              <div class="card-media">
                <img
                  src="{{ product.featured_media | image_url: width: 600 }}"
                  alt="{{ product.featured_media.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
                {% if product.available == false %}
                  <span class="badge">Sold out</span>
                {% elsif product.tags contains 'low-inventory' or handle == 'low-inventory' %}
                  {% if product.selected_or_first_available_variant.inventory_quantity != blank and product.selected_or_first_available_variant.inventory_quantity <= 3 and product.selected_or_first_available_variant.inventory_quantity > 0 %}
                    <span class="badge badge--low">Low stock</span>
                  {% endif %}
                {% endif %}
              </div>
              {% assign mfr = product.metafields.custom.manufacturer.value | default: product.metafields.custom.manufacturer %}
              {% if mfr != blank %}
                {% assign m_down = mfr | downcase %}
                {% unless m_down contains 'escentshow' or m_down contains 'ebay' %}
                  <p class="card-vendor">{{ mfr }}</p>
                {% endunless %}
              {% endif %}
              <p class="card-title">{{ product.title }}</p>
              <p class="card-price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <span class="compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </p>
            </a>

            {% assign seen_ids = seen_ids | append: product.id | append: ',' %}
            {% assign rail_ids = rail_ids | append: product.id | append: ',' %}
            {% assign rail_shown = rail_shown | plus: 1 %}
          {% endfor %}

          {% comment %} Pass 2 — still need visible slots; allow no-media {% endcomment %}
          {% for product in col.products limit: 50 %}
            {% if rail_shown >= visible_limit %}{% break %}{% endif %}
            {% if product.featured_media %}{% continue %}{% endif %}
            {% assign id_token = product.id | prepend: ',' | append: ',' %}
            {% if seen_ids contains id_token %}{% continue %}{% endif %}
            {% if rail_ids contains id_token %}{% continue %}{% endif %}

            <a class="card" href="{{ product.url }}">
              <div class="card-media"></div>
              {% assign mfr = product.metafields.custom.manufacturer.value | default: product.metafields.custom.manufacturer %}
              {% if mfr != blank %}
                {% assign m_down = mfr | downcase %}
                {% unless m_down contains 'escentshow' or m_down contains 'ebay' %}
                  <p class="card-vendor">{{ mfr }}</p>
                {% endunless %}
              {% endif %}
              <p class="card-title">{{ product.title }}</p>
              <p class="card-price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <span class="compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </p>
            </a>

            {% assign seen_ids = seen_ids | append: product.id | append: ',' %}
            {% assign rail_ids = rail_ids | append: product.id | append: ',' %}
            {% assign rail_shown = rail_shown | plus: 1 %}
          {% endfor %}

          {% comment %} Pass 3 — scroll overflow; within-rail unique; may repeat other rails; media only {% endcomment %}
          {% for product in col.products limit: 50 %}
            {% if rail_shown >= products_per_rail %}{% break %}{% endif %}
            {% unless product.featured_media %}{% continue %}{% endunless %}
            {% assign id_token = product.id | prepend: ',' | append: ',' %}
            {% if rail_ids contains id_token %}{% continue %}{% endif %}

            <a class="card" href="{{ product.url }}">
              <div class="card-media">
                <img
                  src="{{ product.featured_media | image_url: width: 600 }}"
                  alt="{{ product.featured_media.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              </div>
              {% assign mfr = product.metafields.custom.manufacturer.value | default: product.metafields.custom.manufacturer %}
              {% if mfr != blank %}
                {% assign m_down = mfr | downcase %}
                {% unless m_down contains 'escentshow' or m_down contains 'ebay' %}
                  <p class="card-vendor">{{ mfr }}</p>
                {% endunless %}
              {% endif %}
              <p class="card-title">{{ product.title }}</p>
              <p class="card-price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <span class="compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </p>
            </a>

            {% assign rail_ids = rail_ids | append: product.id | append: ',' %}
            {% assign rail_shown = rail_shown | plus: 1 %}
          {% endfor %}

          <a class="view-all-card" href="{{ href }}">View all</a>
        </div>
      {% endif %}
    </div>
  </section>
{% endfor %}

{% schema %}
{
  "name": "Vault rails",
  "tag": "div",
  "class": "section-vault-rails",
  "settings": [
    {
      "type": "range",
      "id": "visible_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "First-scroll unique cards per rail",
      "default": 5,
      "info": "Cross-rail dedupe applies to this many cards per rail (initially visible window)."
    },
    {
      "type": "range",
      "id": "products_per_rail",
      "min": 5,
      "max": 24,
      "step": 1,
      "label": "Cards per rail (incl. scroll overflow)",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "rail",
      "name": "Vault rail",
      "settings": [
        {
          "type": "text",
          "id": "collection_handle",
          "label": "Collection handle",
          "info": "Locked: popular, beauty-sets, rare-hard-to-find, low-inventory"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (optional override)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading / kicker"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vault rails",
      "blocks": [
        {
          "type": "rail",
          "settings": {
            "collection_handle": "popular",
            "heading": "Popular",
            "subheading": "The vault"
          }
        },
        {
          "type": "rail",
          "settings": {
            "collection_handle": "beauty-sets",
            "heading": "Beauty sets",
            "subheading": "The vault"
          }
        },
        {
          "type": "rail",
          "settings": {
            "collection_handle": "rare-hard-to-find",
            "heading": "Rare · Hard to find",
            "subheading": "The vault"
          }
        },
        {
          "type": "rail",
          "settings": {
            "collection_handle": "low-inventory",
            "heading": "Low inventory",
            "subheading": "The vault"
          }
        }
      ]
    }
  ]
}
{% endschema %}

