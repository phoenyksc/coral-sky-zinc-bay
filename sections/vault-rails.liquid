{% comment %}
  Discover — full wrapping grid of randomized in-stock products (not a carousel).
  Hardcoded after Beauty Sets rails; no Theme Editor collection block required.
  Candidates: collections.all first, then popular / rare-hard-to-find / low-inventory fill.
  Dedupe against seen_ids from earlier rails. Client shuffle keeps first N (default 36).
{% endcomment %}
{% if section.settings.discover_enabled != false %}
  {% assign discover_heading = section.settings.discover_heading | default: 'Discover' %}
  {% assign discover_subheading = section.settings.discover_subheading | default: 'A fresh mix each visit' %}
  {% assign discover_count = section.settings.discover_count | default: 36 %}
  {% assign discover_cap = 50 %}
  {% assign discover_shown = 0 %}
  {% assign discover_ids = ',' %}
  {% assign discover_sources = 'all,popular,rare-hard-to-find,low-inventory' | split: ',' %}

  <section class="section vault-discover" id="vault-discover">
    <div class="page-width">
      <div class="section-head">
        <div>
          {% if discover_subheading != blank %}
            <p class="kicker">{{ discover_subheading }}</p>
          {% endif %}
          <h2>{{ discover_heading }}</h2>
        </div>
      </div>

      <div
        class="product-grid product-grid--discover vault-discover-grid"
        data-random-count="{{ discover_count }}"
        data-vault-rail="discover"
      >
        {% for src in discover_sources %}
          {% if discover_shown >= discover_cap %}{% break %}{% endif %}
          {% assign dcol = collections[src] %}
          {% if dcol == blank or dcol.products_count == 0 %}{% continue %}{% endif %}
          {% for product in dcol.products limit: 50 %}
            {% if discover_shown >= discover_cap %}{% break %}{% endif %}
            {% unless product.available %}{% continue %}{% endunless %}
            {% unless product.featured_media %}{% continue %}{% endunless %}
            {% assign id_token = product.id | prepend: ',' | append: ',' %}
            {% if seen_ids contains id_token %}{% continue %}{% endif %}
            {% if discover_ids contains id_token %}{% continue %}{% endif %}

            {% assign card_href = product.url %}
            {% if card_href == blank and product.handle != blank %}
              {% assign card_href = product.handle | prepend: '/products/' %}
            {% endif %}
            <a class="card card--compact" href="{{ card_href }}"{% if card_href == blank %} aria-disabled="true"{% endif %}>
              <div class="card-media">
                <img
                  src="{{ product.featured_media | image_url: width: 400 }}"
                  alt="{{ product.featured_media.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              </div>
              {% assign mfr = product.metafields.custom.manufacturer.value | default: product.metafields.custom.manufacturer %}
              {% if mfr != blank %}
                {% assign m_down = mfr | downcase %}
                {% unless m_down contains 'escentshow' or m_down contains 'ebay' %}
                  <p class="card-vendor">{{ mfr }}</p>
                {% endunless %}
              {% endif %}
              <p class="card-title">{{ product.title }}</p>
              <p class="card-price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <span class="compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </p>
            </a>

            {% assign discover_ids = discover_ids | append: product.id | append: ',' %}
            {% assign discover_shown = discover_shown | plus: 1 %}
          {% endfor %}
        {% endfor %}
      </div>

      <script>
        (function () {
          var grid = document.querySelector('[data-vault-rail="discover"]');
          if (!grid) return;
          var keep = parseInt(grid.getAttribute('data-random-count') || '36', 10);
          if (!keep || keep < 1) keep = 36;
          var cards = Array.prototype.slice.call(grid.querySelectorAll(':scope > a.card'));
          if (cards.length <= keep) return;
          for (var i = cards.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var tmp = cards[i];
            cards[i] = cards[j];
            cards[j] = tmp;
          }
          for (var k = 0; k < cards.length; k++) {
            if (k < keep) {
              grid.appendChild(cards[k]);
            } else {
              cards[k].parentNode && cards[k].parentNode.removeChild(cards[k]);
            }
          }
        })();
      </script>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Vault rails",
  "tag": "div",
  "class": "section-vault-rails",
  "settings": [
    {
      "type": "range",
      "id": "visible_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "First-scroll unique cards per rail",
      "default": 5,
      "info": "Cross-rail dedupe applies to this many cards per rail (initially visible window)."
    },
    {
      "type": "range",
      "id": "products_per_rail",
      "min": 5,
      "max": 24,
      "step": 1,
      "label": "Cards per rail (incl. scroll overflow)",
      "default": 15
    },
    {
      "type": "header",
      "content": "Discover grid"
    },
    {
      "type": "checkbox",
      "id": "discover_enabled",
      "label": "Show Discover grid",
      "default": true,
      "info": "Full wrapping grid of randomized in-stock products after Beauty Sets. Theme-only; no collection wiring."
    },
    {
      "type": "text",
      "id": "discover_heading",
      "label": "Discover heading",
      "default": "Discover"
    },
    {
      "type": "text",
      "id": "discover_subheading",
      "label": "Discover kicker / subheading",
      "default": "A fresh mix each visit"
    },
    {
      "type": "range",
      "id": "discover_count",
      "min": 30,
      "max": 40,
      "step": 1,
      "label": "Discover cards to show",
      "default": 36,
      "info": "Server renders up to ~50 candidates; JS shuffles and keeps this many."
    }
  ],
  "blocks": [
    {
      "type": "rail",
      "name": "Vault rail",
      "settings": [
        {
          "type": "text",
          "id": "collection_handle",
          "label": "Collection handle",
          "info": "Locked: popular, beauty-sets, rare-hard-to-find, low-inventory"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (optional override)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading / kicker"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vault rails",
      "blocks": [
        {
          "type": "rail",
          "settings": {
            "collection_handle": "popular",
            "heading": "Popular",
            "subheading": "Most sold and most watched"
          }
        },
        {
          "type": "rail",
          "settings": {
            "collection_handle": "rare-hard-to-find",
            "heading": "Rare · hard to find",
            "subheading": "Discontinued and allocated — while they last"
          }
        },
        {
          "type": "rail",
          "settings": {
            "collection_handle": "low-inventory",
            "heading": "Low inventory",
            "subheading": "Fewer than six in the warehouse"
          }
        },
        {
          "type": "rail",
          "settings": {
            "collection_handle": "beauty-sets",
            "heading": "Beauty sets",
            "subheading": "Kits, vaults, and gift sets"
          }
        }
      ]
    }
  ]
}
{% endschema %}
