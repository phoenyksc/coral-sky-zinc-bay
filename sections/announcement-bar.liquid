{%- comment -%} 2026-10-15 HERO-V2: compact single-line announcement, rendered ABOVE the header (header-group order).
 Desktop/tablet: lines side by side with a dot. Phones: both lines stacked (v5, no rotation). {%- endcomment -%}
{%- if section.settings.announcement != blank -%}
{%- assign ann = section.settings.announcement | newline_to_br | split: '<br />' -%}
<div class="sb-ann" role="region" aria-label="Store announcements">
  <div class="sb-ann__track{% if ann.size > 1 %} sb-ann--rot{% endif %}">
    {%- for l in ann -%}{%- assign t = l | strip -%}{%- if t != blank -%}<span class="sb-ann__line">{{ t }}</span>{%- endif -%}{%- endfor -%}
  </div>
</div>
<style>
  .sb-ann{background:#fff;border-bottom:1px solid var(--line);height:28px;overflow:hidden;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);line-height:28px;text-align:center}
  .sb-ann__track{display:flex;justify-content:center;gap:0}
  .sb-ann__line{white-space:nowrap;padding:0 .9rem}
  .sb-ann__line+.sb-ann__line{border-left:1px solid var(--line)}
  @media(max-width:767px){
    /* v5: phones show BOTH lines stacked, static (no rotation) */
    .sb-ann{height:auto;line-height:1.35;padding:4px 0;font-size:9.5px;letter-spacing:.08em}
    .sb-ann__track{flex-direction:column;gap:1px}
    .sb-ann__line{display:block;padding:0 .6rem;overflow:hidden;text-overflow:ellipsis}
    .sb-ann__line+.sb-ann__line{border-left:0}
  }
</style>
{%- endif -%}
{% schema %}
{
  "name": "Announcement",
  "settings": [
    { "type": "textarea", "id": "announcement", "label": "Announcement text", "info": "One message per line. Desktop: side by side. Phones: stacked.", "default": "Free standard shipping on US orders $75+\nAuthenticity guaranteed · Ships from the USA" }
  ]
}
{% endschema %}
