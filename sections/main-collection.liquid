{% comment %}
  Collection grid + facets. Product type / Brand = dropdowns in facets.
  Load More Products (no page switching). Skip Vendor-as-brand on cards.
{% endcomment %}
<section class="section" id="CollectionSection-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width">
    <header class="section-head">
      <h1 style="font-size:clamp(2rem,4vw,3rem);margin:0">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="prose">{{ collection.description }}</div>
      {% endif %}
    </header>

    <div class="collection-layout" style="display:grid;gap:2rem;margin-top:2rem">
      <aside>
        {% render 'facets' %}
        {% if collection.filters == empty %}
          <p class="prose" style="font-size:.85rem">Filters appear when products are in this collection.</p>
        {% endif %}
      </aside>
      <div>
        {% paginate collection.products by section.settings.products_per_page %}
          {% if collection.products.size == 0 %}
            <div class="empty">
              <h2>No products yet</h2>
              <p class="prose">This collection will fill as catalog membership lands.</p>
            </div>
          {% else %}
            <div
              id="ProductGrid-{{ section.id }}"
              class="product-grid"
              data-page="{{ paginate.current_page }}"
              data-pages="{{ paginate.pages }}"
            >
              {% for product in collection.products %}
                <a class="card" href="{{ product.url }}">
                  <div class="card-media">
                    {% if product.featured_media %}
                      <img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.featured_media.alt | escape }}" loading="lazy" width="600" height="600">
                    {% endif %}
                  </div>
                  {% assign mfr = product.metafields.custom.manufacturer.value | default: product.metafields.custom.manufacturer %}
                  {% if mfr != blank %}
                    {% assign m_down = mfr | downcase %}
                    {% unless m_down contains 'escentshow' or m_down contains 'ebay' %}
                      <p class="card-vendor">{{ mfr }}</p>
                    {% endunless %}
                  {% endif %}
                  <p class="card-title">{{ product.title }}</p>
                  <p class="card-price">{{ product.price | money }}</p>
                </a>
              {% endfor %}
            </div>
          {% endif %}

          {% if paginate.pages > 1 and paginate.current_page < paginate.pages %}
            <div class="load-more-wrap" style="margin-top:2rem;text-align:center" id="LoadMoreWrap-{{ section.id }}">
              <button
                type="button"
                class="btn"
                id="LoadMore-{{ section.id }}"
                data-next-url="{{ collection.url }}?page={{ paginate.current_page | plus: 1 }}&section_id={{ section.id }}"
              >
                Load More Products
              </button>
            </div>
          {% endif %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var btn = document.getElementById('LoadMore-{{ section.id }}');
  var grid = document.getElementById('ProductGrid-{{ section.id }}');
  var wrap = document.getElementById('LoadMoreWrap-{{ section.id }}');
  if (!btn || !grid) return;

  btn.addEventListener('click', function () {
    var url = btn.getAttribute('data-next-url');
    if (!url) return;
    btn.disabled = true;
    btn.textContent = 'Loading…';

    fetch(url)
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var nextGrid = doc.getElementById('ProductGrid-{{ section.id }}');
        var nextBtn = doc.getElementById('LoadMore-{{ section.id }}');
        if (nextGrid) {
          Array.prototype.forEach.call(nextGrid.children, function (card) {
            grid.appendChild(card);
          });
        }
        if (nextBtn) {
          btn.setAttribute('data-next-url', nextBtn.getAttribute('data-next-url'));
          btn.disabled = false;
          btn.textContent = 'Load More Products';
        } else if (wrap) {
          wrap.remove();
        }
      })
      .catch(function () {
        btn.disabled = false;
        btn.textContent = 'Load More Products';
      });
  });
})();
</script>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 12,
      "label": "Products per load",
      "default": 24
    }
  ],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
