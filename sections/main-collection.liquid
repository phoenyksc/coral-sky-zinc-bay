{% comment %}
  Collection grid + facets. Product type / Brand = dropdowns in facets.
  Load more / Show all (no page switching; next pages fetched via section_id with the
  current query string, so filters + sort_by carry over). Skip Vendor-as-brand on cards.
{% endcomment %}
<section class="section" id="CollectionSection-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width">
    <header class="section-head">
      <h1 style="font-size:clamp(2rem,4vw,3rem);margin:0">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="prose">{{ collection.description }}</div>
      {% endif %}
    </header>

    <div class="collection-layout" style="display:grid;gap:2rem;margin-top:2rem">
      <aside>
        {% render 'facets' %}
        {% if collection.filters == empty %}
          <p class="prose" style="font-size:.85rem">Filters appear when products are in this collection.</p>
        {% endif %}
      </aside>
      <div>
        {% paginate collection.products by section.settings.products_per_page %}
          {% if collection.products.size == 0 %}
            <div class="empty">
              <h2>No products yet</h2>
              <p class="prose">This collection will fill as catalog membership lands.</p>
            </div>
          {% else %}
            <div
              id="ProductGrid-{{ section.id }}"
              class="product-grid"
              data-page="{{ paginate.current_page }}"
              data-pages="{{ paginate.pages }}"
            >
              {% for product in collection.products %}
                {% comment %} Skip blank cream cards — same as Discover/vault-rails no-featured_media guard {% endcomment %}
                {% unless product.featured_media %}{% continue %}{% endunless %}
                {% assign card_href = product.url %}
                {% if card_href == blank and product.handle != blank %}
                  {% assign card_href = product.handle | prepend: '/products/' %}
                {% endif %}
                <a class="card" href="{{ card_href }}"{% if card_href == blank %} aria-disabled="true"{% endif %}>
                  <div class="card-media">
                    {% if product.featured_media %}
                      <img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.featured_media.alt | escape }}" loading="lazy" width="600" height="600">
                    {% endif %}
                  </div>
                  {% assign mfr = product.metafields.custom.manufacturer.value | default: product.metafields.custom.manufacturer %}
                  {% if mfr != blank %}
                    {% assign m_down = mfr | downcase %}
                    {% unless m_down contains 'escentshow' or m_down contains 'ebay' %}
                      <p class="card-vendor">{{ mfr }}</p>
                    {% endunless %}
                  {% endif %}
                  <p class="card-title">{{ product.title }}</p>
                  <p class="card-price">{{ product.price | money }}</p>
                </a>
              {% endfor %}
            </div>
          {% endif %}

          {% if paginate.pages > 1 and paginate.current_page < paginate.pages %}
            <div
              class="load-more-wrap"
              id="LoadMoreWrap-{{ section.id }}"
              data-next-page="{{ paginate.current_page | plus: 1 }}"
              data-pages="{{ paginate.pages }}"
              style="margin-top:2rem;display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;align-items:center"
            >
              <button type="button" class="btn" id="LoadMore-{{ section.id }}">Load more</button>
              <button type="button" class="btn btn--outline" id="ShowAll-{{ section.id }}">Show all</button>
            </div>
          {% endif %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var sectionId = '{{ section.id }}';
  var root = document.getElementById('CollectionSection-' + sectionId);
  var grid = document.getElementById('ProductGrid-' + sectionId);
  var wrap = document.getElementById('LoadMoreWrap-' + sectionId);
  var moreBtn = document.getElementById('LoadMore-' + sectionId);
  var allBtn = document.getElementById('ShowAll-' + sectionId);
  if (!root || !grid || !wrap || !moreBtn) return;

  var MORE_LABEL = 'Load more';
  var ALL_LABEL = 'Show all';
  var LOADING_LABEL = 'Loading…';
  var SHOW_ALL_MAX_PAGES = 400; // 2026-10-05 Dru: Show all loads everything (safety cap only).
  var nextPage = parseInt(wrap.getAttribute('data-next-page'), 10) || 2;
  var lastPage = parseInt(wrap.getAttribute('data-pages'), 10) || 1;
  var busy = false;

  function isDone() { return nextPage > lastPage; }

  function finish() {
    if (wrap.parentNode) wrap.parentNode.removeChild(wrap);
  }

  function setBusy(on, which) {
    busy = on;
    moreBtn.disabled = on;
    moreBtn.textContent = on && which === 'more' ? LOADING_LABEL : MORE_LABEL;
    if (allBtn) {
      allBtn.disabled = on;
      allBtn.textContent = on && which === 'all' ? LOADING_LABEL : ALL_LABEL;
    }
    wrap.setAttribute('aria-busy', on ? 'true' : 'false');
  }

  // Keep every current query param (filters, sort_by, q, type, ...); only swap page + section_id.
  function pageUrl(page) {
    var u = new URL(window.location.href);
    u.searchParams.set('page', String(page));
    u.searchParams.set('section_id', sectionId);
    u.hash = '';
    return u.pathname + u.search;
  }

  // Fetch one page via the Section Rendering API (same section => same card markup and skips) and append its cards.
  function fetchPage(page) {
    return fetch(pageUrl(page), { credentials: 'same-origin' })
      .then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.text();
      })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var nextGrid = doc.getElementById('ProductGrid-' + sectionId);
        if (!nextGrid) {
          // Section rendered but no grid => past the last page. Anything else is an error.
          if (doc.getElementById('CollectionSection-' + sectionId)) { lastPage = page - 1; return; }
          throw new Error('Unexpected response');
        }
        var pages = parseInt(nextGrid.getAttribute('data-pages'), 10);
        if (pages) lastPage = pages;
        // Copy to a static array first: appendChild moves nodes out of the live HTMLCollection.
        Array.prototype.slice.call(nextGrid.children).forEach(function (card) {
          grid.appendChild(card);
        });
        nextPage = page + 1;
      });
  }

  if (isDone()) { finish(); return; }

  moreBtn.addEventListener('click', function () {
    if (busy || isDone()) return;
    setBusy(true, 'more');
    fetchPage(nextPage)
      .then(function () {
        setBusy(false);
        if (isDone()) finish();
      })
      .catch(function () {
        setBusy(false); // re-enable so the shopper can retry
      });
  });

  if (allBtn) {
    allBtn.addEventListener('click', function () {
      if (busy || isDone()) return;
      setBusy(true, 'all');
      var fetched = 0;
      (function step() {
        if (isDone()) { setBusy(false); finish(); return; }
        if (fetched >= SHOW_ALL_MAX_PAGES) { setBusy(false); return; }
        fetched += 1;
        allBtn.textContent = 'Loading… ' + Math.min(nextPage, lastPage) + ' / ' + lastPage;
        fetchPage(nextPage).then(step).catch(function () {
          setBusy(false); // re-enable on failure; cards already appended stay
        });
      })();
    });
  }
})();
</script>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 12,
      "label": "Products per load",
      "default": 24
    }
  ],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
