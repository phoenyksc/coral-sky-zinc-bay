{% comment %}
  Sol Beautiful hero — thin Sephora-style banner (Dru 2026-10-12).
  Short white panel: copy left, 2–4 in-stock product shots right (object-fit: contain, never cropped).
  Products come from `hero_products` (comma-separated handles, hand-picked: clean white backgrounds, no watermarks).
  Any product that is sold out, missing media, or $999/blank priced is skipped at render time.
  If none qualify, falls back to first in-stock products with media from `hero_fallback_collection`.
{% endcomment %}
{% assign hero_handles = section.settings.hero_products | default: '' | split: ',' %}
{% assign hero_max = 4 %}
{% assign hero_shown = 0 %}
<style>
  #Hero-{{ section.id }}.hero--thin{min-height:0;display:block;overflow:visible;background:transparent;padding:1rem 0}
  #Hero-{{ section.id }} .hero-panel{display:grid;grid-template-columns:1fr;gap:1rem;align-items:center;background:#fff;border:1px solid var(--line);border-radius:12px;padding:1.25rem 1.25rem;overflow:hidden}
  #Hero-{{ section.id }} .hero-copy{position:static;padding:0;max-width:34rem}
  #Hero-{{ section.id }} h1{font-size:clamp(1.75rem,3.4vw,2.6rem);margin-top:.35rem}
  #Hero-{{ section.id }} p.lede{margin-top:.5rem;font-size:.92rem;max-width:30rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  #Hero-{{ section.id }} .hero-actions{margin-top:1rem;gap:.5rem}
  #Hero-{{ section.id }} .hero-actions .btn--lg{min-height:2.6rem;padding:0 1.15rem}
  #Hero-{{ section.id }} .hero-products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem;height:9rem}
  #Hero-{{ section.id }} .hero-products a:nth-child(n+4){display:none}
  #Hero-{{ section.id }} .hero-product{display:block;background:#fff;border-radius:8px;height:100%;padding:.4rem}
  #Hero-{{ section.id }} .hero-product img{position:static;width:100%;height:100%;object-fit:contain;object-position:center}
  @media(min-width:768px){
    #Hero-{{ section.id }}.hero--thin{padding:1.25rem 0}
    #Hero-{{ section.id }} .hero-panel{grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:2rem;padding:1.5rem 2.25rem;height:17rem}
    #Hero-{{ section.id }} .hero-products{grid-template-columns:repeat(4,minmax(0,1fr));height:13.5rem}
    #Hero-{{ section.id }} .hero-products a:nth-child(n+4){display:block}
  }
</style>
<section class="hero hero--thin" id="Hero-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="hero-panel">
      <div class="hero-copy">
        {% if section.settings.kicker != blank %}
          <p class="kicker">{{ section.settings.kicker }}</p>
        {% endif %}
        <h1>{{ section.settings.heading }}</h1>
        {% if section.settings.lede != blank %}
          <p class="lede">{{ section.settings.lede }}</p>
        {% endif %}
        <div class="hero-actions">
          {% if section.settings.cta1_label != blank %}
            <a class="btn btn--lg" href="{{ section.settings.cta1_link | default: '/collections/popular' }}">{{ section.settings.cta1_label }}</a>
          {% endif %}
          {% if section.settings.cta2_label != blank %}
            <a class="btn btn--lg btn--outline" href="{{ section.settings.cta2_link | default: '/collections/skincare' }}">{{ section.settings.cta2_label }}</a>
          {% endif %}
        </div>
      </div>
      <div class="hero-products">
        {% for h in hero_handles %}
          {% if hero_shown >= hero_max %}{% break %}{% endif %}
          {% assign hh = h | strip %}
          {% assign p = all_products[hh] %}
          {% if p == blank or p.available == false or p.featured_media == blank %}{% continue %}{% endif %}
          {% if p.price_max >= 99999 or p.price_max <= 0 %}{% continue %}{% endif %}
          <a class="hero-product" href="{{ p.url }}">
            {{ p.featured_media | image_url: width: 600 | image_tag: loading: 'eager', widths: '300,450,600', sizes: '(min-width: 768px) 14vw, 30vw', alt: p.title }}
          </a>
          {% assign hero_shown = hero_shown | plus: 1 %}
        {% endfor %}
        {% if hero_shown == 0 %}
          {% assign fb = collections[section.settings.hero_fallback_collection] | default: collections.popular %}
          {% for p in fb.products limit: 30 %}
            {% if hero_shown >= hero_max %}{% break %}{% endif %}
            {% if p.available == false or p.featured_media == blank %}{% continue %}{% endif %}
            {% if p.price_max >= 99999 or p.price_max <= 0 %}{% continue %}{% endif %}
            <a class="hero-product" href="{{ p.url }}">
              {{ p.featured_media | image_url: width: 600 | image_tag: loading: 'eager', widths: '300,450,600', sizes: '(min-width: 768px) 14vw, 30vw', alt: p.title }}
            </a>
            {% assign hero_shown = hero_shown | plus: 1 %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image (unused in thin layout)" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For the love of beauty and skin." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Scent that stays. Color that feels like you. Care that skin remembers." },
    { "type": "text", "id": "cta1_label", "label": "Primary CTA label", "default": "Shop the Vault" },
    { "type": "url", "id": "cta1_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA label", "default": "Skincare" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" },
    { "type": "textarea", "id": "hero_products", "label": "Hero product handles", "info": "Comma-separated. Clean white-background shots only; sold-out are skipped automatically." },
    { "type": "text", "id": "hero_fallback_collection", "label": "Fallback collection handle", "default": "popular" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
