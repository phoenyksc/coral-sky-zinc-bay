{% comment %}
  Sol Beautiful — SEGMENTED CAMPAIGN HERO (reusable). OFFLINE DRAFT 2026-10-12, not live.
  Sephora-style row of large promo cards: media on top, solid colour panel below
  (headline, one-line subtext, CTA, compact "shop the look" thumbs with badge).
  Full-bleed: no page-width container, cards span the viewport at every size.
  Desktop (>=990px): 3 cards visible + arrows. Tablet: 2. Mobile: ~1.2 visible, swipe with peek.
  Each card = a "segment" BLOCK (add / remove / reorder in the theme editor).
  Campaign swap: see README-campaign-hero.md in the go-live folder.
{% endcomment %}
{%- if section.settings.enabled and section.blocks.size > 0 -%}
<style>
  #CH-{{ section.id }}{width:100%;max-width:none;margin:0;padding:{{ section.settings.pad_top }}px 0 1rem;background:{{ section.settings.section_bg }}}
  #CH-{{ section.id }} .ch-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:0 clamp(12px,2vw,24px) .6rem}
  #CH-{{ section.id }} .ch-eyebrow{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;margin:0;opacity:.75}
  #CH-{{ section.id }} .ch-title{font-size:clamp(1.15rem,2vw,1.6rem);margin:.1rem 0 0}
  #CH-{{ section.id }} .ch-nav{display:flex;gap:.4rem}
  #CH-{{ section.id }} .ch-arrow{width:40px;height:40px;border-radius:50%;border:1px solid #1a1a1a;background:#fff;cursor:pointer;font-size:1.1rem;line-height:1}
  #CH-{{ section.id }} .ch-track{display:flex;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;scroll-padding:0 8px;padding:0 8px}
  #CH-{{ section.id }} .ch-track::-webkit-scrollbar{display:none}
  #CH-{{ section.id }} .ch-card{flex:0 0 calc((100% - 16px - 16px)/3);scroll-snap-align:start;display:flex;flex-direction:column;overflow:hidden;border-radius:6px;color:var(--ch-ink,#fff);background:var(--ch-panel)}
  #CH-{{ section.id }} .ch-media{display:block;aspect-ratio:9/8;overflow:hidden;background:#111}
  #CH-{{ section.id }} .ch-media img{display:block;width:100%;height:100%;object-fit:cover;object-position:center var(--ch-focus,20%)}
  #CH-{{ section.id }} .ch-panel{display:flex;flex-direction:column;gap:.35rem;padding:1rem 1.1rem 1.1rem;flex:1}
  #CH-{{ section.id }} .ch-h{font-size:clamp(1.15rem,1.7vw,1.5rem);line-height:1.15;margin:0;color:inherit}
  #CH-{{ section.id }} .ch-sub{font-size:.9rem;margin:0;opacity:.9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #CH-{{ section.id }} .ch-cta{color:inherit;font-weight:700;font-size:.9rem;text-decoration:underline;text-underline-offset:3px;align-self:flex-start}
  #CH-{{ section.id }} .ch-thumbs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.45rem;margin-top:.5rem}
  #CH-{{ section.id }} .ch-thumb{position:relative;display:flex;flex-direction:column;gap:.15rem;color:inherit;text-decoration:none;font-size:.66rem;line-height:1.2}
  #CH-{{ section.id }} .ch-thumb img{width:100%;aspect-ratio:1;object-fit:contain;background:#fff;border-radius:4px}
  #CH-{{ section.id }} .ch-thumb__name{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  #CH-{{ section.id }} .ch-thumb__price{font-weight:700}
  #CH-{{ section.id }} .ch-badge{position:absolute;top:3px;left:3px;font-size:.55rem;font-weight:700;padding:1px 4px;border-radius:3px;background:#f2c14e;color:#1a1a1a}
  #CH-{{ section.id }} .ch-dots{display:none;justify-content:center;gap:6px;padding-top:.6rem}
  #CH-{{ section.id }} .ch-dot{width:7px;height:7px;border-radius:50%;background:#1a1a1a;opacity:.25}
  @media(max-width:989px){#CH-{{ section.id }} .ch-card{flex-basis:calc((100% - 16px - 8px)/2)}}
  @media(max-width:749px){
    #CH-{{ section.id }} .ch-card{flex-basis:80%}
    #CH-{{ section.id }} .ch-nav{display:none}
    #CH-{{ section.id }} .ch-dots{display:flex}
    #CH-{{ section.id }} .ch-panel{padding:.8rem .85rem .9rem}
  }
  @media(prefers-reduced-motion:reduce){#CH-{{ section.id }} .ch-track{scroll-behavior:auto}}
</style>
<section id="CH-{{ section.id }}" class="campaign-hero" aria-roledescription="carousel" aria-label="{{ section.settings.title | default: 'Featured' | escape }}" {{ section.shopify_attributes }}>
  {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
  <div class="ch-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="ch-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="ch-title">{{ section.settings.title }}</h2>{%- endif -%}
    </div>
    <div class="ch-nav">
      <button type="button" class="ch-arrow" data-dir="-1" aria-label="Previous">&#8249;</button>
      <button type="button" class="ch-arrow" data-dir="1" aria-label="Next">&#8250;</button>
    </div>
  </div>
  {%- endif -%}
  <div class="ch-track" data-ch-track>
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- assign link = b.link | default: '/collections/all' -%}
      <article class="ch-card" style="--ch-panel:{{ b.panel_color }};--ch-ink:{{ b.text_color }};--ch-focus:{{ b.focus }}%" {{ block.shopify_attributes }}>
        <a class="ch-media" href="{{ link }}" tabindex="-1" aria-hidden="true">
          {%- if b.image != blank -%}
            {{ b.image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '400,600,900,1200', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 80vw', alt: b.headline }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </a>
        <div class="ch-panel">
          {%- if b.headline != blank -%}<h3 class="ch-h">{{ b.headline }}</h3>{%- endif -%}
          {%- if b.subtext != blank -%}<p class="ch-sub">{{ b.subtext }}</p>{%- endif -%}
          {%- if b.cta_label != blank -%}<a class="ch-cta" href="{{ link }}">{{ b.cta_label }}</a>{%- endif -%}
          {%- assign shown = 0 -%}
          {%- capture thumbs -%}
            {%- for p in b.products -%}
              {%- unless p.available -%}{%- continue -%}{%- endunless -%}
              {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
              <a class="ch-thumb" href="{{ p.url }}">
                {%- if shown == 0 and b.badge != blank -%}<span class="ch-badge">{{ b.badge }}</span>{%- endif -%}
                {{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: p.title, widths: '100,200' }}
                <span class="ch-thumb__name">{{ p.title | truncate: 40 }}</span><span class="ch-thumb__price">{{ p.price | money }}</span>
              </a>
              {%- assign shown = shown | plus: 1 -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if shown > 0 -%}<div class="ch-thumbs">{{ thumbs }}</div>{%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
  <div class="ch-dots" aria-hidden="true">{%- for block in section.blocks -%}<span class="ch-dot"></span>{%- endfor -%}</div>
  <script>
    (function(){var r=document.getElementById('CH-{{ section.id }}');if(!r)return;var t=r.querySelector('[data-ch-track]');
      r.querySelectorAll('.ch-arrow').forEach(function(b){b.addEventListener('click',function(){var c=t.querySelector('.ch-card');t.scrollBy({left:(c?c.offsetWidth+8:t.clientWidth)*+b.dataset.dir,behavior:'smooth'});});});
    })();
  </script>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Campaign hero",
  "tag": "div",
  "class": "section-campaign-hero",
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show campaign hero", "default": true, "info": "Manual on/off. No dates: switch off or swap blocks when the campaign ends." },
    { "type": "text", "id": "eyebrow", "label": "Campaign eyebrow", "default": "The Halloween Makeup Edit" },
    { "type": "text", "id": "title", "label": "Campaign title", "default": "Get the look" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 12 }
  ],
  "blocks": [
    {
      "type": "segment",
      "name": "Segment card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Still campaign image, ~9:8 (720x640). Keep burned-in text away from the edges." },
        { "type": "range", "id": "focus", "label": "Vertical focus", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 20 },
        { "type": "color", "id": "panel_color", "label": "Panel colour", "default": "#3b1f3a" },
        { "type": "color", "id": "text_color", "label": "Panel text colour", "default": "#ffffff" },
        { "type": "text", "id": "headline", "label": "Headline", "default": "Headline" },
        { "type": "text", "id": "subtext", "label": "Subtext (one line)" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop Now" },
        { "type": "url", "id": "link", "label": "CTA link" },
        { "type": "product_list", "id": "products", "label": "Shop the look", "limit": 6, "info": "First available = lead product. Sold-out items are skipped; up to 4 shown." },
        { "type": "text", "id": "badge", "label": "Badge on lead product", "info": "e.g. MAC pick, Stand-in, New. Blank = none." }
      ]
    }
  ],
  "presets": [{ "name": "Campaign hero", "blocks": [{ "type": "segment" }, { "type": "segment" }, { "type": "segment" }] }]
}
{% endschema %}
