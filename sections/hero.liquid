{% comment %}
  Sol Beautiful hero — Grok Build match.
  Headline + CTAs. Used on password + index when configured.
{% endcomment %}
<section class="hero" id="Hero-{{ section.id }}" {{ section.shopify_attributes }}>
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '800,1200,1600,2400', alt: section.settings.heading }}
  {% else %}
    <img src="{{ 'hero.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1600" height="900" loading="eager">
  {% endif %}
  <span class="hero-veil" aria-hidden="true"></span>
  <div class="page-width hero-copy">
    {% if section.settings.kicker != blank %}
      <p class="kicker">{{ section.settings.kicker }}</p>
    {% endif %}
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.lede != blank %}
      <p class="lede">{{ section.settings.lede }}</p>
    {% endif %}
    <div class="hero-actions">
      {% if section.settings.cta1_label != blank %}
        <a class="btn btn--lg" href="{{ section.settings.cta1_link | default: '/collections/popular' }}">{{ section.settings.cta1_label }}</a>
      {% endif %}
      {% if section.settings.cta2_label != blank %}
        <a class="btn btn--lg btn--outline" href="{{ section.settings.cta2_link | default: '/collections/skincare' }}">{{ section.settings.cta2_label }}</a>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For the love of beauty and skin." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Scent that stays. Color that feels like you. Care that skin remembers." },
    { "type": "text", "id": "cta1_label", "label": "Primary CTA label", "default": "Shop the Vault" },
    { "type": "url", "id": "cta1_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA label", "default": "Skincare" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
