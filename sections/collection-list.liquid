<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div>
        <p class="kicker">{{ section.settings.kicker }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <a href="{{ routes.collections_url }}" class="kicker">All collections →</a>
    </div>
    <div class="collection-tiles">
      {% for block in section.blocks %}
        {% assign col = block.settings.collection %}
        {% if col != blank %}
          <a class="tile" href="{{ col.url }}" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 900 | image_tag: alt: col.title, loading: 'lazy' }}
            {% elsif col.featured_image %}
              {{ col.featured_image | image_url: width: 900 | image_tag: alt: col.title, loading: 'lazy' }}
            {% else %}
              <img src="{{ 'collection-makeup.jpg' | asset_url }}" alt="{{ col.title | escape }}">
            {% endif %}
            <span class="tile-veil"></span>
            <span>{{ col.title }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The vault" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we love" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
