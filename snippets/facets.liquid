{% comment %}
  Storefront filters via Search & Discovery (collection.filters).
  Show Price, Product type, and Brand/Manufacturer (NOT Vendor).
  Dru LOCK 2026-09-17: NO Availability filter — OOS appears naturally in collections.
  Skip Vendor + Availability. Product type + Brand = <select>; Price = range.
{% endcomment %}
{% if collection.filters != empty %}
  <form class="facets" data-facets-form action="{{ collection.url }}" method="get">
    <p class="kicker" style="margin-bottom:1rem">Filter</p>
    {% assign has_active = false %}
    {% for filter in collection.filters %}
      {% assign label_down = filter.label | downcase %}
      {% assign skip = false %}
      {% comment %} Never expose Shopify Vendor (store name) {% endcomment %}
      {% if filter.param_name == 'filter.p.vendor' or label_down == 'vendor' %}
        {% assign skip = true %}
      {% endif %}
      {% comment %} Dru LOCK: no Availability / in stock / out of stock filter {% endcomment %}
      {% if label_down contains 'availability' or label_down == 'in stock' or label_down contains 'out of stock' or filter.param_name == 'filter.v.availability' %}
        {% assign skip = true %}
      {% endif %}
      {% unless skip %}
        {% if filter.active_values.size > 0 %}
          {% assign has_active = true %}
        {% endif %}
        {% if filter.min_value.value != blank or filter.max_value.value != blank %}
          {% assign has_active = true %}
        {% endif %}

        {% assign use_select = false %}
        {% assign facet_label = filter.label %}
        {% if label_down contains 'product type' or filter.param_name == 'filter.p.product_type' %}
          {% assign use_select = true %}
          {% assign facet_label = 'Product type' %}
        {% elsif label_down contains 'manufacturer' or label_down contains 'brand' %}
          {% assign use_select = true %}
          {% assign facet_label = 'Brand' %}
        {% endif %}

        <div class="facet" style="margin-bottom:1.25rem">
          <p class="kicker">{{ facet_label }}</p>
          {% case filter.type %}
            {% when 'list' %}
              {% if use_select %}
                {% comment %}
                  Single <select> for Product type / Brand (even if S&D allows multi).
                  Empty first option = All (no filter param). On change, submit.
                {% endcomment %}
                {% assign select_name = filter.param_name %}
                {% for value in filter.values %}
                  {% if select_name == blank %}
                    {% assign select_name = value.param_name %}
                  {% endif %}
                {% endfor %}
                <select
                  class="field"
                  name="{{ select_name }}"
                  style="margin-top:.5rem;width:100%;max-width:18rem"
                  data-facet-auto>
                  <option value="">All</option>
                  {% for value in filter.values %}
                    <option
                      value="{{ value.value }}"
                      {% if value.active %}selected{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                      {{ value.label }} ({{ value.count }})
                    </option>
                  {% endfor %}
                </select>
              {% else %}
                {% comment %} Availability and any other list filters: checkboxes {% endcomment %}
                <ul style="list-style:none;padding:0;margin:.5rem 0 0">
                  {% for value in filter.values %}
                    <li style="margin:.35rem 0">
                      <label style="display:flex;gap:.5rem;align-items:center;font-size:.9rem">
                        <input type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          data-facet-auto>
                        <span>{{ value.label }} ({{ value.count }})</span>
                      </label>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            {% when 'price_range' %}
              <div style="display:flex;gap:.5rem;margin-top:.5rem;align-items:center;flex-wrap:wrap">
                <input class="field" type="number" name="{{ filter.min_value.param_name }}"
                  value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                  placeholder="Min" min="0" style="width:6rem">
                <span>–</span>
                <input class="field" type="number" name="{{ filter.max_value.param_name }}"
                  value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                  placeholder="Max" min="0" style="width:6rem">
                <button class="btn btn--outline" type="submit">Go</button>
              </div>
            {% when 'boolean' %}
              {% for value in filter.values %}
                <label style="display:flex;gap:.5rem;align-items:center;font-size:.9rem;margin:.35rem 0">
                  <input type="checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    {% if value.active %}checked{% endif %}
                    data-facet-auto>
                  <span>{{ value.label }}</span>
                </label>
              {% endfor %}
          {% endcase %}
        </div>
      {% endunless %}
    {% endfor %}
    {% if has_active %}
      <a class="btn btn--outline" href="{{ collection.url }}">Clear filters</a>
    {% endif %}
  </form>
{% comment %} 2026-10-12 filter fix: AJAX facets (Section Rendering API), strips empty params, swaps grid in place, falls back to full reload. {% endcomment %}
<p class="facets-status" data-facets-status aria-live="polite" style="font-size:.85rem;min-height:1.2em;margin:.25rem 0 0"></p>
<script>
(function () {
  if (window.__solFacetsBound) return;
  window.__solFacetsBound = true;
  function cleanQuery(form) {
    var fd = new FormData(form), p = new URLSearchParams();
    fd.forEach(function (v, k) { if (String(v).trim() !== '') p.append(k, v); });
    var cur = new URLSearchParams(location.search);
    ['sort_by', 'q', 'type'].forEach(function (k) { if (cur.get(k) && !p.has(k)) p.set(k, cur.get(k)); });
    return p;
  }
  function apply(form) {
    var section = form.closest('[data-section-id]');
    var p = cleanQuery(form);
    var action = form.getAttribute('action') || location.pathname;
    var pageUrl = action + (p.toString() ? '?' + p.toString() : '');
    if (!section || !window.fetch || !window.DOMParser) { location.assign(pageUrl); return; }
    var sid = section.getAttribute('data-section-id');
    var status = section.querySelector('[data-facets-status]');
    if (status) status.textContent = 'Updating…';
    section.setAttribute('aria-busy', 'true');
    section.style.opacity = '.55';
    var q = new URLSearchParams(p); q.set('section_id', sid);
    fetch(action + '?' + q.toString(), { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.getElementById(section.id);
        if (!fresh) throw new Error('no section');
        history.pushState({ solFacets: 1 }, '', pageUrl);
        section.replaceWith(fresh);
        fresh.querySelectorAll('script').forEach(function (old) {
          var s = document.createElement('script');
          s.textContent = old.textContent;
          old.replaceWith(s);
        });
        var grid = fresh.querySelector('[id^="ProductGrid-"]');
        var n = grid ? grid.children.length : 0;
        var st = fresh.querySelector('[data-facets-status]');
        if (st) st.textContent = grid ? 'Showing results' : 'No products match these filters';
        var target = grid || fresh.querySelector('.empty');
        if (target && window.matchMedia('(max-width: 989px)').matches) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
      .catch(function () { location.assign(pageUrl); });
  }
  document.addEventListener('change', function (e) {
    var el = e.target;
    if (!el.matches || !el.matches('[data-facet-auto]')) return;
    var form = el.closest('form[data-facets-form]');
    if (form) apply(form);
  });
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!form.matches || !form.matches('form[data-facets-form]')) return;
    e.preventDefault();
    apply(form);
  });
  window.addEventListener('popstate', function () { location.reload(); });
})();
</script>

{% endif %}
