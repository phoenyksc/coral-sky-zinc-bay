{%- comment -%} You May Also Like tile. p = product. Tracking: data-section="ymal", data-position (set 1..N by JS after filtering), link ?ref=ymal. {%- endcomment -%}
{%- assign yt_href = p.url -%}{%- if p.url == blank -%}{%- assign yt_href = '/products/' | append: p.handle -%}{%- endif -%}
<a class="ymal-tile" href="{{ yt_href }}?ref=ymal" data-section="ymal" data-position="" data-handle="{{ p.handle }}">
  <span class="ymal-media"><img src="{{ p.featured_media | image_url: width: 400 }}" alt="{{ p.featured_media.alt | default: p.title | escape }}" loading="lazy" width="400" height="400"></span>
  {%- assign yt_mfr = p.metafields.custom.manufacturer.value | default: p.metafields.custom.manufacturer -%}
  {%- if yt_mfr != blank -%}{%- assign yt_m = yt_mfr | downcase -%}{%- unless yt_m contains 'escentshow' or yt_m contains 'ebay' -%}<span class="ymal-vendor">{{ yt_mfr }}</span>{%- endunless -%}{%- endif -%}
  <span class="ymal-title">{{ p.title }}</span>
  <span class="ymal-price">{{ p.price | money }}</span>
</a>
