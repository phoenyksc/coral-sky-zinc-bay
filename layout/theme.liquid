<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}
      {% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    {%- if settings.favicon -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="icon" type="image/png" sizes="512x512" href="{{ settings.favicon | image_url: width: 512, height: 512 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}
    {%- assign sb_share = 'solbeautiful-share-1200x630-2026-10-12.png' | file_url -%}
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:description" content="{{ page_description | default: shop.description | default: shop.name | escape }}">
    {%- if page_image and request.page_type != 'index' -%}
      <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
      <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
    {%- else -%}
      <meta property="og:image" content="https:{{ sb_share }}">
      <meta property="og:image:secure_url" content="https:{{ sb_share }}">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | default: shop.name | escape }}">
    <meta name="twitter:description" content="{{ page_description | default: shop.description | default: shop.name | escape }}">
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% render 'sitewide-density' %}
    <style id="sb-branding-2026-10-12">
      :root{--bg:#faf8f3;--card:#ffffff;--wash:#f1eee6;--line:#e6e1d6}
      body{background-color:var(--bg);background-image:none}
      .zen-strip:after{background:linear-gradient(to bottom,rgba(250,248,243,.2),transparent 40%,rgba(250,248,243,.5))}
      .logo--image{display:flex;align-items:center;height:100%;line-height:0}
      .logo__img{height:66px;width:auto;max-width:calc(100vw - 184px);object-fit:contain;object-position:left center}
      @media(max-width:374px){.logo__img{height:62px}}
      @media(min-width:768px){.logo__img{height:84px;max-width:none}}
      @media(max-width:767px){.header-bar.page-width{width:100%;height:4.5rem;padding:0 .25rem;gap:.25rem}.header-bar .icon-btn{width:2.5rem;height:2.75rem}}
      @media(min-width:768px){.header-bar{height:5.75rem}}
    </style>
    {{ content_for_header }}
  </head>
  <body>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
