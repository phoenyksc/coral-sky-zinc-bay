<div class="section">
  <div class="page-width-narrow">
    <p class="kicker">Your vault</p>
    <h1 style="font-size:3rem">Create an account</h1>
    <p style="margin-top:.75rem;color:var(--muted)">Open an account and take 10% off your first purchase. Save a card and an address after checkout.</p>
    {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <div style="display:grid;gap:1rem;margin-top:1.5rem">
        <input class="field" type="text" name="customer[first_name]" placeholder="First name" required>
        <input class="field" type="text" name="customer[last_name]" placeholder="Last name">
        <input class="field" type="email" name="customer[email]" placeholder="Email" required>
        <input class="field" type="password" name="customer[password]" placeholder="Password" required>
        <button class="btn" type="submit">Create account · 10% off first purchase</button>
      </div>
    {% endform %}
    <p style="margin-top:1rem"><a href="{{ routes.account_login_url }}">Already have an account? Sign in</a></p>
  </div>
</div>
