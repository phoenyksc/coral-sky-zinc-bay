<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=Outfit:wght@400&display=swap" rel="stylesheet">
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="empty">
      <p class="kicker">Sol Beautiful</p>
      <h1>For the love of beauty and skin.</h1>
      <p class="lede" style="margin:1rem auto;max-width:28rem;color:var(--muted)">A family-run California vault. Enter the storefront password to preview.</p>
      {% form 'storefront_password' %}
        <div style="display:flex;gap:.5rem;justify-content:center;margin-top:1.5rem">
          <input class="field" type="password" name="password" placeholder="Password" style="max-width:16rem">
          <button class="btn" type="submit">Enter</button>
        </div>
      {% endform %}
    </main>
  </body>
</html>
