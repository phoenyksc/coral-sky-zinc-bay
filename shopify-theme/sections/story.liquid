<section class="section">
  <div class="page-width">
    <div class="story-split">
      <div class="story-grid">
        <img class="wide" src="{{ 'story-young.jpg' | asset_url }}" alt="">
        <img src="{{ 'story-prime.jpg' | asset_url }}" alt="">
        <img src="{{ 'story-mid.jpg' | asset_url }}" alt="">
        <img src="{{ 'story-elder.jpg' | asset_url }}" alt="">
        <img src="{{ 'story-botanical.jpg' | asset_url }}" alt="">
      </div>
      <div class="story-copy">
        <p class="kicker">{{ section.settings.kicker }}</p>
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.body != blank %}
          <p>{{ section.settings.body }}</p>
        {% endif %}
        <div class="hero-actions">
          <a class="btn" href="/pages/about">Our story</a>
          <a class="btn btn--outline" href="/collections/skincare">Shop skincare</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Our story",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The vault" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Forty years of family care." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text",
      "default": "A family-run beauty vault for more than forty years — customer first, carefully spoken to, and curated for quality and rare fragrance. We ship from the USA."
    }
  ],
  "presets": [{ "name": "Our story" }]
}
{% endschema %}
