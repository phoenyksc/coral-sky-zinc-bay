<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div>
        <p class="kicker">{{ section.settings.kicker }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="story-grid">
      <img class="wide" src="{{ 'story-young.jpg' | asset_url }}" alt="">
      <img src="{{ 'story-prime.jpg' | asset_url }}" alt="">
      <img src="{{ 'story-mid.jpg' | asset_url }}" alt="">
      <img src="{{ 'story-elder.jpg' | asset_url }}" alt="">
      <img src="{{ 'story-botanical.jpg' | asset_url }}" alt="">
    </div>
    {% if section.settings.body != blank %}
      <div class="prose" style="max-width:42rem;margin-top:2rem">
        {{ section.settings.body }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Our story",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A family vault. Forty years of beauty." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text",
      "default": "Sol Beautiful is a family-run vault, and has been for more than forty years. We ship from the USA."
    }
  ],
  "presets": [{ "name": "Our story" }]
}
{% endschema %}
